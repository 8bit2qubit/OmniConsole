<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game Bar widget（UWP）以 net10 + Native AOT 建置。
       PhantomBridge.winmd 的 COM 註冊由 Package.appxmanifest 手動宣告 com:ExeServer，
       不提供 Implementation metadata，故忽略 APPX1707。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseUwp>true</UseUwp>
    <EnableMsixTooling>true</EnableMsixTooling>
    <RootNamespace>OmniConsole.PhantomLink</RootNamespace>
    <AssemblyName>OmniConsole.PhantomLinkWidget</AssemblyName>
    <!-- OmniConsole.sln 以此 GUID 繫結本專案，須與 sln 一致。 -->
    <ProjectGuid>{7EF8DAF9-69DF-403D-9716-4B10898086B4}</ProjectGuid>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <NoWarn>$(NoWarn);APPX1707;NETSDK1023</NoWarn>

    <!-- 版本資訊固定欄位（比照主程式 OmniConsole.csproj）；版號由下方 SyncVersionFromMainManifest target 覆寫。 -->
    <Company>8bit2qubit</Company>
    <Product>OmniConsole</Product>
    <Authors>8bit2qubit</Authors>
    <Copyright>Copyright (C) 2026 8bit2qubit</Copyright>
    <AssemblyTitle>OmniConsole OmniCharm</AssemblyTitle>
    <Description>OmniConsole OmniCharm Game Bar Widget</Description>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Native AOT：非 Debug 開 PublishAot（比照主程式 OmniConsole.csproj）。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Gaming.XboxGameBar" Version="7.3.2607010" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260610101">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- XboxGameBar 的 winmd 與 native dll 顯式封裝進套件：winmd 供 proxyStub manifest 宣告，
       native dll 供 XboxGameBarWidget 的 WinRT activation。 -->
  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)microsoft.gaming.xboxgamebar\7.3.2607010\lib\uap10.0\Microsoft.Gaming.XboxGameBar.winmd">
      <Link>Microsoft.Gaming.XboxGameBar.winmd</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(NuGetPackageRoot)microsoft.gaming.xboxgamebar\7.3.2607010\runtimes\win10-x64\native\Microsoft.Gaming.XboxGameBar.dll">
      <Link>Microsoft.Gaming.XboxGameBar.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 單一專案 MSIX 封裝能力。 -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!-- 以 CsWinRT 投影 XboxGameBar 的 WinRT 型別。 -->
  <PropertyGroup>
    <CsWinRTIncludes>Microsoft.Gaming.XboxGameBar</CsWinRTIncludes>
  </PropertyGroup>
  <ItemGroup>
    <CsWinRTInputs Include="$(NuGetPackageRoot)microsoft.gaming.xboxgamebar\7.3.2607010\lib\uap10.0\Microsoft.Gaming.XboxGameBar.winmd" />
  </ItemGroup>

  <!-- helper DLL（含 PhantomBridgeFactory COM 包裝）；PhantomBridge.winmd 僅以 Content 封裝供 runtime。 -->
  <ItemGroup>
    <Reference Include="OmniConsole.PhantomLink.Core">
      <HintPath>..\OmniConsole\Phantom\OmniConsole.PhantomLink.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- 套件資訊清單（含 com:ExeServer、Game Bar widget AppExtension、proxyStub 宣告）。 -->
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <!-- 在地化資源 .resw 由 SDK 預設 glob 自動收，不顯式宣告。 -->

  <!-- widget 圖示與啟動畫面（封裝進 msix）。 -->
  <ItemGroup>
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <!-- PhantomBridge full trust COM server 三檔隨 widget 封裝。 -->
  <ItemGroup>
    <Content Include="..\OmniConsole.PhantomBridge\x64\$(Configuration)\OmniConsole.PhantomBridge.exe">
      <Link>OmniConsole.PhantomBridge.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\OmniConsole\Phantom\OmniConsole.PhantomBridge.dll">
      <Link>OmniConsole.PhantomBridge.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\OmniConsole\Phantom\PhantomBridge.winmd">
      <Link>PhantomBridge.winmd</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 版本資訊跟隨主程式 Package.appxmanifest 的 Identity.Version（比照主程式 XmlPeek 寫法）。 -->
  <Target Name="SyncVersionFromMainManifest" BeforeTargets="GetAssemblyVersion;CoreCompile"
          Condition="Exists('$(ProjectDir)..\OmniConsole\Package.appxmanifest')">
    <XmlPeek XmlInputPath="$(ProjectDir)..\OmniConsole\Package.appxmanifest"
             Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version">
      <Output TaskParameter="Result" PropertyName="_OmniVersion" />
    </XmlPeek>
    <PropertyGroup Condition="'$(_OmniVersion)' != ''">
      <Version>$(_OmniVersion)</Version>
      <FileVersion>$(_OmniVersion)</FileVersion>
      <AssemblyVersion>$(_OmniVersion)</AssemblyVersion>
    </PropertyGroup>
    <!-- widget 自身 Package.appxmanifest 的 Identity.Version 也同步。 -->
    <XmlPoke Condition="'$(_OmniVersion)' != ''"
             XmlInputPath="$(ProjectDir)Package.appxmanifest"
             Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version"
             Value="$(_OmniVersion)" />
  </Target>

  <!-- 建置前先建 PhantomBridge COM server（vcxproj 固定 x64）。 -->
  <Target Name="BuildPhantomBridgeLoader" BeforeTargets="BeforeBuild">
    <MSBuild Projects="..\OmniConsole.PhantomBridge\OmniConsole.PhantomBridge.vcxproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=x64" />
  </Target>
</Project>
