  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
  <Target Name="SyncVersionFromMainManifest" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -Command &quot;[xml]$m = Get-Content '$(ProjectDir)..\OmniConsole\Package.appxmanifest'; $v = $m.Package.Identity.Version; [xml]$t = Get-Content '$(ProjectDir)Package.appxmanifest'; if ($t.Package.Identity.Version -ne $v) { $t.Package.Identity.Version = $v; $t.Save('$(ProjectDir)Package.appxmanifest') }&quot;" />
  </Target>
  <!-- PhantomBridge (fulltrust C++/WinRT COM server) 必須先於 PhantomLink 建置。
       不用 <ProjectReference>：傳統 UWP / .NET Native csproj 的 ResolveProjectReferences
       不會自動觸發 vcxproj 建置，實測會出 MSB3073（PhantomBridge.0.h 不存在）。
       明確的 <Target><MSBuild Projects=.../></Target> 是這個 toolchain 上實測可靠的依賴宣告之一。
       Platform 鎖 x64：PhantomLink msix 為 x64-only，PhantomBridge 對齊 x64。 -->
  <Target Name="BuildPhantomBridge" BeforeTargets="BeforeBuild">
    <MSBuild Projects="..\OmniConsole.PhantomBridge\OmniConsole.PhantomBridge.vcxproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=x64" />
  </Target>
  <!-- 從 cppwinrt 產出的 PhantomBridge.0.h 解析 IPhantomBridgeFactory 的 IID，
       產生 Generated\PhantomBridgeIIDs.g.cs。IDL 變更 → IID 自動同步到 C#。

       設計要點：
         1. BeforeTargets 同時掛 BeforeBuild 與 CoreCompile：CoreCompile 在增量建置中
            可能被跳過，連帶 BeforeTargets 也不執行；雙掛保證 IID 同步。
         2. DependsOnTargets="BuildPhantomBridge" 鎖序：.h 必須先由 vcxproj 產出。
         3. .g.cs 由本 target 動態加入 Compile item，避免乾淨 repo 首次建置報 CS2001。
         4. 不設 Inputs/Outputs incremental check：腳本內部已比對內容相同則不寫檔。 -->
  <Target Name="GeneratePhantomBridgeIIDs"
          BeforeTargets="BeforeBuild;CoreCompile"
          DependsOnTargets="BuildPhantomBridge">
    <PropertyGroup>
      <_PhantomBridgeHeader>..\OmniConsole.PhantomBridge\x64\$(Configuration)\Intermediate\Generated Files\winrt\impl\PhantomBridge.0.h</_PhantomBridgeHeader>
      <_PhantomBridgeIIDsFile>$(ProjectDir)Generated\PhantomBridgeIIDs.g.cs</_PhantomBridgeIIDsFile>
    </PropertyGroup>
    <MakeDir Directories="$(ProjectDir)Generated" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Build\GeneratePhantomBridgeIIDs.ps1&quot; -HeaderPath &quot;$(_PhantomBridgeHeader)&quot; -OutputPath &quot;$(_PhantomBridgeIIDsFile)&quot;" />
    <ItemGroup>
      <Compile Include="$(_PhantomBridgeIIDsFile)" />
    </ItemGroup>
  </Target>
