<Page
    x:Class="OmniConsole.PhantomLink.PhantomLinkWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmniConsole.PhantomLink"
    xmlns:services="using:OmniConsole.PhantomLink.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseSystemFocusVisuals="False">

    <Page.Resources>
        <Style TargetType="ToggleButton">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <!-- Button 圓角比照 ToggleButton 視覺風格（Quick Actions 用） -->
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24,0,24,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RootPanel" Spacing="12" Margin="0,0,12,0">

                <!-- 隱形焦點哨兵：吸收 Game Bar 首次進入不顯框的現象（詳細焦點流程見 code-behind）。
                     0 高度、透明、可聚焦；須是 RootPanel 直屬子才被 section 導航清單認到。 -->
                <Button x:Name="FocusSentinel"
                        Height="0" MinHeight="0" Padding="0" Margin="0" Opacity="0"
                        BorderThickness="0" Background="Transparent"
                        HorizontalAlignment="Stretch"
                        UseSystemFocusVisuals="False"/>

                <!-- <TextBlock Text="OmniCharm" FontSize="20" FontWeight="SemiBold"/> -->

                <!-- 前景程式區塊：一行顯示「目前：<App 名稱> (<行程名稱>)」，提供「自訂此 App」入口 -->
                <StackPanel x:Name="ForegroundAppSection" Spacing="4">
                    <TextBlock x:Name="ForegroundAppLineText" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- CustomizeAppNoteText：前景為系統管理員程式時顯示說明 -->
                    <TextBlock x:Name="CustomizeAppNoteText"
                               x:Uid="Widget_CustomizeApp_ElevatedNote"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <Button x:Name="CustomizeAppBtn" x:Uid="Widget_CustomizeApp"
                            Click="CustomizeAppBtn_Click"
                            HorizontalAlignment="Stretch"
                            UseSystemFocusVisuals="True"
                            XYFocusDown="{x:Bind TaskViewBtn}"/>
                </StackPanel>

                <!-- Quick Actions: TaskView / XboxLibrary 兩顆水平排列；委派給 PhantomBridge COM server。
                     不設 XYFocusUp：讓 D-pad Up 從最頂端按鈕外移到 Game Bar，使用者能回到小工具切換列。
                     XboxLibrary 補回 Game Bar Library 原本的 xbox://library 功能（該按鈕被 OmniConsole 接管後遺漏的入口）。

                     SettingsBtn 暫時註解保留：使用者可從 Game Bar Library 入口替代。日後研究後再啟用。 -->
                <Grid x:Name="QuickActionsSection" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TaskViewBtn" Grid.Column="0"
                            Click="TaskViewBtn_Click"
                            HorizontalAlignment="Stretch"
                            UseSystemFocusVisuals="True"
                            XYFocusDown="{x:Bind SteamInGameOverlayOffBtn}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7C4;" FontSize="16"/>
                            <TextBlock x:Uid="Widget_OpenTaskView"/>
                        </StackPanel>
                    </Button>
                    <!--
                    <Button x:Name="SettingsBtn" Grid.Column="?"
                            Click="SettingsBtn_Click"
                            HorizontalAlignment="Stretch"
                            UseSystemFocusVisuals="True"
                            XYFocusDown="{x:Bind SteamInGameOverlayOnBtn}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="16"/>
                            <TextBlock x:Uid="Widget_OpenSettings"/>
                        </StackPanel>
                    </Button>
                    -->
                    <Button x:Name="XboxLibraryBtn" Grid.Column="1"
                            Click="XboxLibraryBtn_Click"
                            HorizontalAlignment="Stretch"
                            UseSystemFocusVisuals="True"
                            XYFocusDown="{x:Bind SteamInGameOverlayOnBtn}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE990;" FontSize="16"/>
                            <TextBlock x:Uid="Widget_OpenXboxLibrary"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Steam In-Game Overlay: [Off] [Trigger] [On] 三顆水平排列（獨立於 Mouse Mode，不受內建手把映射影響）。
                     Trigger 置中：D-pad 進入此區段時 PickFocusTarget 會落在 IsChecked 的 Off 或 On，
                     兩側皆距離 Trigger 一格；不論目前狀態為何，「進入 + 一步」即可觸發。
                     Trigger 條件可見性（FSE + 預設平台為 SteamBigPicture）由 ReloadFromStore 處理；
                     不可見時 Off/On 的水平 XYFocus 由程式碼動態改指對方。 -->
                <StackPanel x:Name="SteamInGameOverlaySection" Spacing="6">
                    <TextBlock x:Uid="Widget_SteamInGameOverlay_Title" services:FluentIconTextHelper.AutoFormat="True" FontWeight="SemiBold"/>
                    <StackPanel x:Name="SteamInGameOverlayButtonRow" Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="SteamInGameOverlayOffBtn" x:Uid="Widget_SteamInGameOverlay_Off"
                                      Click="SteamInGameOverlayBtn_Click" Tag="Off"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind TaskViewBtn}"
                                      XYFocusLeft="{x:Bind SteamInGameOverlayOffBtn}"
                                      XYFocusRight="{x:Bind TriggerSteamInGameOverlayBtn}"
                                      XYFocusDown="{x:Bind ModeOffBtn}"/>
                        <Button x:Name="TriggerSteamInGameOverlayBtn"
                                Click="TriggerSteamInGameOverlayBtn_Click"
                                UseSystemFocusVisuals="True"
                                Visibility="Collapsed"
                                XYFocusUp="{x:Bind XboxLibraryBtn}"
                                XYFocusLeft="{x:Bind SteamInGameOverlayOffBtn}"
                                XYFocusRight="{x:Bind SteamInGameOverlayOnBtn}"
                                XYFocusDown="{x:Bind ModeAutoBtn}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA5B;" FontSize="16"/>
                                <TextBlock x:Uid="Widget_TriggerSteamInGameOverlay"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="SteamInGameOverlayOnBtn" x:Uid="Widget_SteamInGameOverlay_On"
                                      Click="SteamInGameOverlayBtn_Click" Tag="On"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind XboxLibraryBtn}"
                                      XYFocusLeft="{x:Bind TriggerSteamInGameOverlayBtn}"
                                      XYFocusRight="{x:Bind SteamInGameOverlayOnBtn}"
                                      XYFocusDown="{x:Bind ModeForceOnBtn}"/>
                    </StackPanel>
                    <!-- 平台適用性說明：此功能仰賴 Steam 長按 ☰ 觸發 Shift+Tab，需預設平台為 Steam Big Picture -->
                    <TextBlock x:Uid="Widget_SteamInGameOverlay_PlatformNote"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Mouse Mode: 3 ToggleButton 水平組 -->
                <StackPanel x:Name="ModeSection" Spacing="6">
                    <TextBlock x:Uid="Widget_MouseMode_Title" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="ModeOffBtn" x:Uid="Widget_Mode_Off"
                                      Click="ModeBtn_Click" Tag="Off"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind SteamInGameOverlayOffBtn}"
                                      XYFocusLeft="{x:Bind ModeOffBtn}"
                                      XYFocusRight="{x:Bind ModeAutoBtn}"
                                      XYFocusDown="{x:Bind LayoutNavBtn}"/>
                        <ToggleButton x:Name="ModeAutoBtn" x:Uid="Widget_Mode_Auto"
                                      Click="ModeBtn_Click" Tag="Auto"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind SteamInGameOverlayOnBtn}"
                                      XYFocusLeft="{x:Bind ModeOffBtn}"
                                      XYFocusRight="{x:Bind ModeForceOnBtn}"
                                      XYFocusDown="{x:Bind LayoutNavBtn}"/>
                        <ToggleButton x:Name="ModeForceOnBtn" x:Uid="Widget_Mode_ForceOn"
                                      Click="ModeBtn_Click" Tag="ForceOn"
                                      UseSystemFocusVisuals="True" MinWidth="88"
                                      XYFocusUp="{x:Bind SteamInGameOverlayOnBtn}"
                                      XYFocusLeft="{x:Bind ModeAutoBtn}"
                                      XYFocusRight="{x:Bind ModeForceOnBtn}"
                                      XYFocusDown="{x:Bind LayoutNavBtn}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Layout: 2 ToggleButton 水平組 -->
                <StackPanel Spacing="6">
                    <TextBlock x:Uid="Widget_Layout_Title" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="LayoutNavBtn" Content="OmniNav"
                                      Click="LayoutBtn_Click" Tag="OmniNav"
                                      UseSystemFocusVisuals="True" MinWidth="96"
                                      XYFocusUp="{x:Bind ModeOffBtn}"
                                      XYFocusLeft="{x:Bind LayoutNavBtn}"
                                      XYFocusRight="{x:Bind LayoutClassicBtn}"
                                      XYFocusDown="{x:Bind CursorSpeedSlider}"/>
                        <ToggleButton x:Name="LayoutClassicBtn" Content="Classic"
                                      Click="LayoutBtn_Click" Tag="Classic"
                                      UseSystemFocusVisuals="True" MinWidth="96"
                                      XYFocusUp="{x:Bind ModeForceOnBtn}"
                                      XYFocusLeft="{x:Bind LayoutNavBtn}"
                                      XYFocusRight="{x:Bind LayoutClassicBtn}"
                                      XYFocusDown="{x:Bind CursorSpeedSlider}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Cursor Speed: Slider -->
                <StackPanel Spacing="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Widget_CursorSpeed_Title" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CursorSpeedValueText" Grid.Column="1"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                    <Slider x:Name="CursorSpeedSlider"
                            Minimum="0" Maximum="7" StepFrequency="1"
                            SnapsTo="StepValues" TickFrequency="1" TickPlacement="Outside"
                            ValueChanged="CursorSpeedSlider_ValueChanged"
                            UseSystemFocusVisuals="True"
                            XYFocusUp="{x:Bind LayoutNavBtn}"
                            XYFocusLeft="{x:Bind CursorSpeedSlider}"
                            XYFocusRight="{x:Bind CursorSpeedSlider}"/>
                </StackPanel>

                <!-- 內建手把映射說明（ROG Ally 家族時顯示） -->
                <TextBlock x:Name="BuiltInMappingNote" x:Uid="Widget_BuiltInMappingNote"
                           Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                           FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
