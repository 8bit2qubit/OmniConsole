<Page
    x:Class="OmniConsole.PhantomLink.PhantomLinkWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OmniConsole.PhantomLink"
    xmlns:services="using:OmniConsole.PhantomLink.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    UseSystemFocusVisuals="False">

    <Page.Resources>
        <Style TargetType="ToggleButton">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <!-- Button 圓角比照 ToggleButton 視覺風格（Quick Actions 用） -->
        <Style TargetType="Button">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24,0,24,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- 各 section 自帶下邊距，不用 StackPanel.Spacing -->
            <StackPanel x:Name="RootPanel" Margin="0,0,12,0">

                <!-- 隱形焦點哨兵：吸收 Game Bar 首次進入不顯框的現象（詳細焦點流程見 code-behind）。
                     0 高度、透明、可聚焦；不標 Tag，切頁時永遠保留。 -->
                <Button x:Name="FocusSentinel"
                        Height="0" MinHeight="0" Padding="0" Margin="0" Opacity="0"
                        BorderThickness="0" Background="Transparent"
                        HorizontalAlignment="Stretch"
                        UseSystemFocusVisuals="False"/>

                <!-- 分頁列：可聚焦，D-pad 往上移到這裡再左右切分頁；不標 Tag，切頁時永遠保留 -->
                <StackPanel x:Name="PageTabSection" Orientation="Horizontal" Spacing="6" Margin="0,0,0,12">
                    <ToggleButton x:Name="MainPageTab" x:Uid="Widget_Page_Main" services:Localized.Uid="Widget_Page_Main"
                                  Click="PageTab_Click" GotFocus="PageTab_GotFocus" Tag="Main"
                                  UseSystemFocusVisuals="True" MinWidth="72"
                                  XYFocusLeft="{x:Bind MainPageTab}"
                                  XYFocusRight="{x:Bind OverlayPageTab}"/>
                    <ToggleButton x:Name="OverlayPageTab" x:Uid="Widget_Page_Overlay" services:Localized.Uid="Widget_Page_Overlay"
                                  Click="PageTab_Click" GotFocus="PageTab_GotFocus" Tag="Overlay"
                                  UseSystemFocusVisuals="True" MinWidth="72"
                                  XYFocusLeft="{x:Bind MainPageTab}"
                                  XYFocusRight="{x:Bind OverlayPageTab}"/>
                </StackPanel>

                <!-- <TextBlock Text="OmniCharm" FontSize="20" FontWeight="SemiBold"/> -->

                <!-- 前景程式區塊：一行顯示「目前：<App 名稱> (<行程名稱>)」，提供「自訂此 App」入口 -->
                <StackPanel x:Name="ForegroundAppSection" Tag="Main" Spacing="4" Margin="0,0,0,12">
                    <TextBlock x:Name="ForegroundAppLineText" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- CustomizeAppNoteText：前景為系統管理員程式時顯示說明 -->
                    <TextBlock x:Name="CustomizeAppNoteText"
                               x:Uid="Widget_CustomizeApp_ElevatedNote" services:Localized.Uid="Widget_CustomizeApp_ElevatedNote"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <Button x:Name="CustomizeAppBtn" x:Uid="Widget_CustomizeApp" services:Localized.Uid="Widget_CustomizeApp"
                            Click="CustomizeAppBtn_Click"
                            HorizontalAlignment="Stretch"
                            UseSystemFocusVisuals="True"
                            XYFocusDown="{x:Bind TaskViewBtn}"/>
                </StackPanel>

                <!-- Quick Actions: TaskView / XboxLibrary 兩顆水平排列；委派給 PhantomBridge COM server。
                     不設 XYFocusUp：讓 D-pad Up 從最頂端按鈕外移到 Game Bar，使用者能回到小工具切換列。
                     XboxLibrary 補回 Game Bar Library 原本的 xbox://library 功能（該按鈕被 OmniConsole 接管後遺漏的入口）。

                     SettingsBtn 暫時註解保留：使用者可從 Game Bar Library 入口替代。日後研究後再啟用。 -->
                <Grid x:Name="QuickActionsSection" Tag="Main" ColumnSpacing="6" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TaskViewBtn" Grid.Column="0"
                            Click="TaskViewBtn_Click"
                            HorizontalAlignment="Stretch"
                            UseSystemFocusVisuals="True"
                            XYFocusDown="{x:Bind SteamInGameOverlayOffBtn}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE7C4;" FontSize="16"/>
                            <TextBlock x:Uid="Widget_OpenTaskView" services:Localized.Uid="Widget_OpenTaskView"/>
                        </StackPanel>
                    </Button>
                    <!--
                    <Button x:Name="SettingsBtn" Grid.Column="?"
                            Click="SettingsBtn_Click"
                            HorizontalAlignment="Stretch"
                            UseSystemFocusVisuals="True"
                            XYFocusDown="{x:Bind SteamInGameOverlayOnBtn}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="16"/>
                            <TextBlock x:Uid="Widget_OpenSettings" services:Localized.Uid="Widget_OpenSettings"/>
                        </StackPanel>
                    </Button>
                    -->
                    <Button x:Name="XboxLibraryBtn" Grid.Column="1"
                            Click="XboxLibraryBtn_Click"
                            HorizontalAlignment="Stretch"
                            UseSystemFocusVisuals="True"
                            XYFocusDown="{x:Bind SteamInGameOverlayOnBtn}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE990;" FontSize="16"/>
                            <TextBlock x:Uid="Widget_OpenXboxLibrary" services:Localized.Uid="Widget_OpenXboxLibrary"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Steam In-Game Overlay: [Off] [Trigger] [On] 三顆水平排列（獨立於 Mouse Mode，不受內建手把映射影響）。
                     Trigger 置中：D-pad 進入此區段時 PickFocusTarget 會落在 IsChecked 的 Off 或 On，
                     兩側皆距離 Trigger 一格；不論目前狀態為何，「進入 + 一步」即可觸發。
                     Trigger 條件可見性（FSE + 預設平台為 SteamBigPicture）由 ReloadFromStore 處理；
                     不可見時 Off/On 的水平 XYFocus 由程式碼動態改指對方。 -->
                <StackPanel x:Name="SteamInGameOverlaySection" Tag="Main" Spacing="6" Margin="0,0,0,12">
                    <TextBlock x:Uid="Widget_SteamInGameOverlay_Title" services:Localized.Uid="Widget_SteamInGameOverlay_Title" services:FluentIconTextHelper.AutoFormat="True" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel x:Name="SteamInGameOverlayButtonRow" Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="SteamInGameOverlayOffBtn" x:Uid="Widget_SteamInGameOverlay_Off" services:Localized.Uid="Widget_SteamInGameOverlay_Off"
                                      Click="SteamInGameOverlayBtn_Click" Tag="Off"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind TaskViewBtn}"
                                      XYFocusLeft="{x:Bind SteamInGameOverlayOffBtn}"
                                      XYFocusRight="{x:Bind TriggerSteamInGameOverlayBtn}"
                                      XYFocusDown="{x:Bind ModeOffBtn}"/>
                        <Button x:Name="TriggerSteamInGameOverlayBtn"
                                Click="TriggerSteamInGameOverlayBtn_Click"
                                UseSystemFocusVisuals="True"
                                Visibility="Collapsed"
                                XYFocusUp="{x:Bind XboxLibraryBtn}"
                                XYFocusLeft="{x:Bind SteamInGameOverlayOffBtn}"
                                XYFocusRight="{x:Bind SteamInGameOverlayOnBtn}"
                                XYFocusDown="{x:Bind ModeOnBtn}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA5B;" FontSize="16"/>
                                <TextBlock x:Uid="Widget_TriggerSteamInGameOverlay" services:Localized.Uid="Widget_TriggerSteamInGameOverlay"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="SteamInGameOverlayOnBtn" x:Uid="Widget_SteamInGameOverlay_On" services:Localized.Uid="Widget_SteamInGameOverlay_On"
                                      Click="SteamInGameOverlayBtn_Click" Tag="On"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind XboxLibraryBtn}"
                                      XYFocusLeft="{x:Bind TriggerSteamInGameOverlayBtn}"
                                      XYFocusRight="{x:Bind SteamInGameOverlayOnBtn}"
                                      XYFocusDown="{x:Bind ModeOnBtn}"/>
                    </StackPanel>
                    <!-- 平台適用性說明：此功能仰賴 Steam 長按 ☰ 觸發 Shift+Tab，需預設平台為 Steam Big Picture -->
                    <TextBlock x:Uid="Widget_SteamInGameOverlay_PlatformNote" services:Localized.Uid="Widget_SteamInGameOverlay_PlatformNote"
                               Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Mouse Mode: Off / On 2 ToggleButton 水平組 -->
                <StackPanel x:Name="ModeSection" Tag="Main" Spacing="6" Margin="0,0,0,12">
                    <TextBlock x:Uid="Widget_GamepadMappingMode_Title" services:Localized.Uid="Widget_GamepadMappingMode_Title" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="ModeOffBtn" x:Uid="Widget_Mode_Off" services:Localized.Uid="Widget_Mode_Off"
                                      Click="ModeBtn_Click" Tag="Off"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind SteamInGameOverlayOffBtn}"
                                      XYFocusLeft="{x:Bind ModeOffBtn}"
                                      XYFocusRight="{x:Bind ModeOnBtn}"
                                      XYFocusDown="{x:Bind LayoutNavBtn}"/>
                        <ToggleButton x:Name="ModeOnBtn" x:Uid="Widget_Mode_On" services:Localized.Uid="Widget_Mode_On"
                                      Click="ModeBtn_Click" Tag="On"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind SteamInGameOverlayOnBtn}"
                                      XYFocusLeft="{x:Bind ModeOffBtn}"
                                      XYFocusRight="{x:Bind ModeOnBtn}"
                                      XYFocusDown="{x:Bind LayoutNavBtn}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 內建廠商映射機種的開啟確認：就地展開，不用對話方塊 -->
                <StackPanel x:Name="BuiltInMappingConfirmSection" Tag="Main" Spacing="8" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="BuiltInMappingConfirmTitle" x:Uid="Widget_BuiltInMappingConfirm_Title" services:Localized.Uid="Widget_BuiltInMappingConfirm_Title" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BuiltInMappingConfirmBody" x:Uid="Widget_BuiltInMappingConfirm_Body" services:Localized.Uid="Widget_BuiltInMappingConfirm_Body" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="BuiltInMappingConfirmBtn" x:Uid="Widget_BuiltInMappingConfirm_Confirm" services:Localized.Uid="Widget_BuiltInMappingConfirm_Confirm"
                                Click="BuiltInMappingConfirmBtn_Click"
                                UseSystemFocusVisuals="True" MinWidth="72"
                                XYFocusUp="{x:Bind BuiltInMappingConfirmBtn}"
                                XYFocusLeft="{x:Bind BuiltInMappingConfirmBtn}"
                                XYFocusRight="{x:Bind BuiltInMappingCancelBtn}"
                                XYFocusDown="{x:Bind BuiltInMappingConfirmBtn}"/>
                        <Button x:Name="BuiltInMappingCancelBtn" x:Uid="Widget_BuiltInMappingConfirm_Cancel" services:Localized.Uid="Widget_BuiltInMappingConfirm_Cancel"
                                Click="BuiltInMappingCancelBtn_Click"
                                UseSystemFocusVisuals="True" MinWidth="72"
                                XYFocusUp="{x:Bind BuiltInMappingCancelBtn}"
                                XYFocusLeft="{x:Bind BuiltInMappingConfirmBtn}"
                                XYFocusRight="{x:Bind BuiltInMappingCancelBtn}"
                                XYFocusDown="{x:Bind BuiltInMappingCancelBtn}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Layout: 3 ToggleButton 水平組（「自訂」是 Pro 專屬，未持有時整顆收起）。
                     MinWidth 對齊上方 Mode 那組的 72，三顆才擺得下。
                     LayoutClassicBtn 的 XYFocusRight 由 code-behind 依「自訂」的顯隱動態改 -->
                <StackPanel Tag="Main" Spacing="6" Margin="0,0,0,12">
                    <TextBlock x:Uid="Widget_ControllerLayoutPreset_Title" services:Localized.Uid="Widget_ControllerLayoutPreset_Title" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="LayoutNavBtn" x:Uid="Widget_ControllerLayoutPreset_OmniNav" services:Localized.Uid="Widget_ControllerLayoutPreset_OmniNav"
                                      Click="LayoutBtn_Click" Tag="OmniNav"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind ModeOffBtn}"
                                      XYFocusLeft="{x:Bind LayoutNavBtn}"
                                      XYFocusRight="{x:Bind LayoutClassicBtn}"
                                      XYFocusDown="{x:Bind CursorSpeedSlider}"/>
                        <ToggleButton x:Name="LayoutClassicBtn" x:Uid="Widget_ControllerLayoutPreset_Classic" services:Localized.Uid="Widget_ControllerLayoutPreset_Classic"
                                      Click="LayoutBtn_Click" Tag="Classic"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind ModeOnBtn}"
                                      XYFocusLeft="{x:Bind LayoutNavBtn}"
                                      XYFocusDown="{x:Bind CursorSpeedSlider}"/>
                        <ToggleButton x:Name="LayoutCustomBtn" x:Uid="Widget_ControllerLayoutPreset_Custom" services:Localized.Uid="Widget_ControllerLayoutPreset_Custom"
                                      Click="LayoutBtn_Click" Tag="Custom"
                                      UseSystemFocusVisuals="True" MinWidth="72" Visibility="Collapsed"
                                      XYFocusUp="{x:Bind ModeOnBtn}"
                                      XYFocusLeft="{x:Bind LayoutClassicBtn}"
                                      XYFocusRight="{x:Bind LayoutCustomBtn}"
                                      XYFocusDown="{x:Bind CursorSpeedSlider}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Cursor Speed: Slider -->
                <StackPanel Tag="Main" Spacing="6" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Widget_CursorSpeed_Title" services:Localized.Uid="Widget_CursorSpeed_Title" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CursorSpeedValueText" Grid.Column="1"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                    <Slider x:Name="CursorSpeedSlider"
                            Minimum="0" Maximum="7" StepFrequency="1"
                            SnapsTo="StepValues" TickFrequency="1" TickPlacement="Outside"
                            ValueChanged="CursorSpeedSlider_ValueChanged"
                            UseSystemFocusVisuals="True"
                            XYFocusUp="{x:Bind LayoutNavBtn}"
                            XYFocusLeft="{x:Bind CursorSpeedSlider}"
                            XYFocusRight="{x:Bind CursorSpeedSlider}"/>
                </StackPanel>

                <!-- 內建手把映射說明（ROG Ally 家族時顯示） -->
                <TextBlock x:Name="BuiltInMappingNote" x:Uid="Widget_BuiltInMappingNote" services:Localized.Uid="Widget_BuiltInMappingNote"
                           Tag="Main" Margin="0,0,0,12"
                           Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                           FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock x:Name="BuiltInMappingProNote" x:Uid="Widget_BuiltInMappingProNote" services:Localized.Uid="Widget_BuiltInMappingProNote"
                           Tag="Main" Margin="0,0,0,12"
                           Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                           FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>

                <!-- 疊加層分頁：三則不可用說明（同時只出現一則）＋五組控制項，不可用時反灰 -->
                <StackPanel x:Name="OverlayNoteSection" Tag="Overlay" Spacing="6" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Uid="Widget_Overlay_Title" services:Localized.Uid="Widget_Overlay_Title"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <!-- 未安裝系統管理員程式支援 -->
                    <TextBlock x:Name="OverlayElevationNote" x:Uid="Widget_Overlay_ElevationNote" services:Localized.Uid="Widget_Overlay_ElevationNote"
                               Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <!-- 沒有安裝 RTSS -->
                    <TextBlock x:Name="OverlayRtssNote" x:Uid="Widget_Overlay_RtssNote" services:Localized.Uid="Widget_Overlay_RtssNote"
                               Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <!-- 裝了但沒在執行 -->
                    <TextBlock x:Name="OverlayRtssStoppedNote" x:Uid="Widget_Overlay_RtssStoppedNote" services:Localized.Uid="Widget_Overlay_RtssStoppedNote"
                               Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- On-Screen Display support：Off / On 兩顆水平組 -->
                <StackPanel x:Name="OverlayOsdSection" Tag="Overlay" Spacing="6" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Uid="Widget_Overlay_Osd_Title" services:Localized.Uid="Widget_Overlay_Osd_Title" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="OverlayOsdOffBtn" x:Uid="Widget_Overlay_Off" services:Localized.Uid="Widget_Overlay_Off"
                                      Click="OverlayOsdBtn_Click" Tag="Off"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusLeft="{x:Bind OverlayOsdOffBtn}"
                                      XYFocusRight="{x:Bind OverlayOsdOnBtn}"
                                      XYFocusDown="{x:Bind OverlayStatOffBtn}"/>
                        <ToggleButton x:Name="OverlayOsdOnBtn" x:Uid="Widget_Overlay_On" services:Localized.Uid="Widget_Overlay_On"
                                      Click="OverlayOsdBtn_Click" Tag="On"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusLeft="{x:Bind OverlayOsdOffBtn}"
                                      XYFocusRight="{x:Bind OverlayOsdOnBtn}"
                                      XYFocusDown="{x:Bind OverlayStatOnBtn}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Show own statistics：Off / On 兩顆水平組 -->
                <StackPanel x:Name="OverlayStatSection" Tag="Overlay" Spacing="6" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Uid="Widget_Overlay_Stat_Title" services:Localized.Uid="Widget_Overlay_Stat_Title" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="OverlayStatOffBtn" x:Uid="Widget_Overlay_Off" services:Localized.Uid="Widget_Overlay_Off"
                                      Click="OverlayStatBtn_Click" Tag="Off"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind OverlayOsdOffBtn}"
                                      XYFocusLeft="{x:Bind OverlayStatOffBtn}"
                                      XYFocusRight="{x:Bind OverlayStatOnBtn}"
                                      XYFocusDown="{x:Bind OverlayShadowOffBtn}"/>
                        <ToggleButton x:Name="OverlayStatOnBtn" x:Uid="Widget_Overlay_On" services:Localized.Uid="Widget_Overlay_On"
                                      Click="OverlayStatBtn_Click" Tag="On"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind OverlayOsdOnBtn}"
                                      XYFocusLeft="{x:Bind OverlayStatOffBtn}"
                                      XYFocusRight="{x:Bind OverlayStatOnBtn}"
                                      XYFocusDown="{x:Bind OverlayShadowOnBtn}"/>
                    </StackPanel>
                </StackPanel>

                <!-- On-Screen Display shadow：Off / On 兩顆水平組 -->
                <StackPanel x:Name="OverlayShadowSection" Tag="Overlay" Spacing="6" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Uid="Widget_Overlay_Shadow_Title" services:Localized.Uid="Widget_Overlay_Shadow_Title" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ToggleButton x:Name="OverlayShadowOffBtn" x:Uid="Widget_Overlay_Off" services:Localized.Uid="Widget_Overlay_Off"
                                      Click="OverlayShadowBtn_Click" Tag="Off"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind OverlayStatOffBtn}"
                                      XYFocusLeft="{x:Bind OverlayShadowOffBtn}"
                                      XYFocusRight="{x:Bind OverlayShadowOnBtn}"
                                      XYFocusDown="{x:Bind OverlayZoomSlider}"/>
                        <ToggleButton x:Name="OverlayShadowOnBtn" x:Uid="Widget_Overlay_On" services:Localized.Uid="Widget_Overlay_On"
                                      Click="OverlayShadowBtn_Click" Tag="On"
                                      UseSystemFocusVisuals="True" MinWidth="72"
                                      XYFocusUp="{x:Bind OverlayStatOnBtn}"
                                      XYFocusLeft="{x:Bind OverlayShadowOffBtn}"
                                      XYFocusRight="{x:Bind OverlayShadowOnBtn}"
                                      XYFocusDown="{x:Bind OverlayZoomSlider}"/>
                    </StackPanel>
                </StackPanel>

                <!-- On-Screen Display zoom：Slider（值域 1..8），水平 XYFocus 指自己 -->
                <StackPanel x:Name="OverlayZoomSection" Tag="Overlay" Spacing="6" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Widget_Overlay_Zoom_Title" services:Localized.Uid="Widget_Overlay_Zoom_Title" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OverlayZoomValueText" Grid.Column="1"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                    <Slider x:Name="OverlayZoomSlider"
                            Minimum="1" Maximum="8" StepFrequency="1"
                            SnapsTo="StepValues" TickFrequency="1" TickPlacement="Outside"
                            ValueChanged="OverlayZoomSlider_ValueChanged"
                            UseSystemFocusVisuals="True"
                            XYFocusUp="{x:Bind OverlayShadowOffBtn}"
                            XYFocusLeft="{x:Bind OverlayZoomSlider}"
                            XYFocusRight="{x:Bind OverlayZoomSlider}"
                            XYFocusDown="{x:Bind OverlayFpsLimitSlider}"/>
                </StackPanel>

                <!-- Framerate limit：Slider 走離散檔位，0 為不限 -->
                <StackPanel x:Name="OverlayFpsLimitSection" Tag="Overlay" Spacing="6" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="Widget_Overlay_FpsLimit_Title" services:Localized.Uid="Widget_Overlay_FpsLimit_Title" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OverlayFpsLimitValueText" Grid.Column="1"
                                   VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                    <Slider x:Name="OverlayFpsLimitSlider"
                            Minimum="0" Maximum="8" StepFrequency="1"
                            SnapsTo="StepValues" TickFrequency="1" TickPlacement="Outside"
                            ValueChanged="OverlayFpsLimitSlider_ValueChanged"
                            UseSystemFocusVisuals="True"
                            XYFocusUp="{x:Bind OverlayZoomSlider}"
                            XYFocusLeft="{x:Bind OverlayFpsLimitSlider}"
                            XYFocusRight="{x:Bind OverlayFpsLimitSlider}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

