<ContentDialog
    x:Class="OmniConsole.Dialogs.AppsUsingPhantomPawDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OmniConsole.Models"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground" Color="#25282C"/>
        <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#1A1B1E"/>
        <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="Transparent"/>
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#25282C"/>

        <Style x:Key="LockedAppCardStyle" TargetType="ContentControl">
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="3"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
            <Setter Property="FocusVisualMargin" Value="-3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="12" MinWidth="420">

        <TextBlock x:Uid="AppsUsingPhantomPawDialog_Header" FontSize="14"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                   TextWrapping="Wrap"/>

        <ScrollViewer MaxHeight="280"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="LockedAppsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:LockingApp">
                        <ContentControl Style="{StaticResource LockedAppCardStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,4">
                            <StackPanel Padding="12,8" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName}" FontSize="14"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind ProcessName}"/><Run Text=".exe (PID "/><Run Text="{x:Bind Pid}"/><Run Text=")"/>
                                </TextBlock>
                                <TextBlock Text="{x:Bind FullPath}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Uid="AppsUsingPhantomPawDialog_Hint" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"/>

    </StackPanel>
</ContentDialog>
