<dialogs:GamepadDialogBase
    x:Class="OmniConsole.Dialogs.AppsUsingPhantomPawDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:OmniConsole.Services"
    xmlns:models="using:OmniConsole.Models"
    xmlns:dialogs="using:OmniConsole.Dialogs"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <dialogs:GamepadDialogBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PhantomDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 關掉 ListViewItem 左側 selection accent bar，焦點視覺僅保留系統圓角白框（比照貓又清單）。 -->
            <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>

            <!-- 卡片外觀（底色/邊框/圓角）；不自畫焦點白框、不可聚焦，焦點落外層 ListViewItem、用系統圓角白框（比照貓又）。 -->
            <Style x:Key="LockedAppCardStyle" TargetType="ContentControl">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </dialogs:GamepadDialogBase.Resources>

    <!-- 三段式 Grid 版面（標題 Auto / 清單 * / 提示 Auto），比照貓又清單 GamepadProfileListView：
         ListView 直坐 Row、外層無 ScrollViewer 等包裝。D-pad 上下走 WinUI 預設 directional focus。 -->
    <Grid MinWidth="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Uid="AppsUsingPhantomPawDialog_Header" services:Localized.Uid="AppsUsingPhantomPawDialog_Header" FontSize="14"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

            <!-- ListView（非 ItemsControl）：比照貓又清單，用 ContainerContentChanging 只在「最後一項」設
                 XYFocusDown 指向重試按鈕（讓最後一張卡片 Down 到「重試」而非幾何最近的「取消」）。
                 IsTabStop=False：容器本身不吃焦點。SelectionMode=None：純資訊清單、不需選取醒目。
                 用 ListView 自己的內建捲動（MaxHeight=280）、不外包 ScrollViewer。 -->
            <ListView x:Name="LockedAppsList"
                      Grid.Row="1"
                      MaxHeight="280"
                      IsTabStop="False"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      Background="Transparent"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ContainerContentChanging="LockedAppsList_ContainerContentChanging">
                <ListView.ItemContainerStyle>
                    <!-- BasedOn 系統 DefaultListViewItemStyle：保留系統圓角白框 FocusVisual（比照貓又清單）。
                         不 BasedOn 會整個蓋掉系統樣式 → 白框消失。只覆寫 padding/min-height 拔內建內距、讓卡片自控版面。
                         焦點落 ListViewItem（可聚焦），裡面卡片 ContentControl 設 IsTabStop=False 不搶焦點。 -->
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:LockingApp">
                        <ContentControl Style="{StaticResource LockedAppCardStyle}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,4">
                            <StackPanel Padding="12,8" Spacing="2">
                                <TextBlock Text="{x:Bind DisplayName}" FontSize="14"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind ProcessName}"/><Run Text=".exe (PID "/><Run Text="{x:Bind Pid}"/><Run Text=")"/>
                                </TextBlock>
                                <TextBlock Text="{x:Bind FullPath}" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        <TextBlock Grid.Row="2" x:Uid="AppsUsingPhantomPawDialog_Hint" services:Localized.Uid="AppsUsingPhantomPawDialog_Hint" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>

    </Grid>
</dialogs:GamepadDialogBase>
