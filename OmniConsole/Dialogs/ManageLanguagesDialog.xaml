<dialogs:GamepadDialogBase
    x:Class="OmniConsole.Dialogs.ManageLanguagesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:OmniConsole.Dialogs"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Close"
    RequestedTheme="Dark">

    <dialogs:GamepadDialogBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PhantomDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 解除 ContentDialog 內建 MaxWidth（預設約 548）：不覆寫的話下方 Border Width=600 會被 clamp 到 548。
                 想讓對話方塊寬於 548 必覆寫此鍵（比照 FilePickerDialog）。 -->
            <x:Double x:Key="ContentDialogMaxWidth">700</x:Double>
        </ResourceDictionary>
    </dialogs:GamepadDialogBase.Resources>

    <!-- 比照 ChangeKeyDialog：固定 Width 的 Border 為主結構（框線恆在、撐滿固定 Width）。
         loading / message / content 三態疊在 Border 內切換 Visibility → 置中天然相對 Border（已撐滿）。
         Width=600（內容寬）；ContentDialogMaxWidth=700 已在 Resources 解除內建 clamp（見上方註解）。 -->
    <Border Width="600" Height="400"
            CornerRadius="4"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1">

        <!-- 三態疊一起（同一 Border 區域內切換）。 -->
        <Grid>

            <!-- 載入中 -->
            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="40" Height="40"/>
                <TextBlock x:Name="LoadingText" TextAlignment="Center" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 錯誤 / 無可用語言 -->
            <StackPanel x:Name="MessagePanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420">
                <FontIcon Glyph="&#xE783;" FontSize="32" HorizontalAlignment="Center"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                <TextBlock x:Name="MessageText" TextAlignment="Center" TextWrapping="Wrap" FontSize="14"/>
            </StackPanel>

            <!-- 內容態：頂部離線提示條（僅離線時顯）+ 雙欄（左語言清單 + 右詳情/動作）-->
            <Grid x:Name="ContentBorder" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 離線提示條：橫跨雙欄；離線時清單只剩已安裝語言、僅能移除。 -->
                <Border x:Name="OfflineBar" Grid.Row="0" Grid.ColumnSpan="2" Visibility="Collapsed"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE783;" FontSize="14" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock x:Name="OfflineBarText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 宣告順序「左欄語言清單在前」：ContentDialog 框架預設焦點落樹中第一個可聚焦元素，
                     本對話方塊初始焦點需求在左欄第一個語言（焦點守衛另在 code-behind 處理右欄按鈕情況）。 -->

                <!-- 左欄：語言清單 -->
                <ListView x:Name="LanguageList" Grid.Row="1" Grid.Column="0"
                          SelectionMode="Single"
                          SingleSelectionFollowsFocus="False"
                          IsItemClickEnabled="True"
                          BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                          BorderThickness="0,0,1,0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:LanguageRow">
                            <TextBlock Text="{x:Bind DisplayName}" FontSize="14" Padding="2,4" TextWrapping="NoWrap"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 右欄：選中語言詳情 + 動作 -->
                <Grid Grid.Row="1" Grid.Column="1" Padding="20">
                    <!-- 未選任何語言時的提示 -->
                    <TextBlock x:Name="DetailEmptyHint"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                    <!-- 選中語言詳情面板 -->
                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed" Spacing="12" VerticalAlignment="Top">
                        <TextBlock x:Name="DetailLangName" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="DetailTranslators" FontSize="14" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DetailStatus" FontSize="14" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="DetailRevision" FontSize="14" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button x:Name="ActionButton" Click="ActionButton_Click"
                                FontSize="14" Padding="24,8" HorizontalAlignment="Left"/>
                        <ProgressRing x:Name="ActionProgress" IsActive="False" Visibility="Collapsed"
                                      Width="24" Height="24" HorizontalAlignment="Left"/>
                        <!-- 動作結果訊息（成功/失敗）：風格比照 CertificateDetailsDialog 的「已複製」提示
                             （FontSize 12 + Tertiary 前景、低調單色、不分成功失敗變色）。 -->
                        <TextBlock x:Name="ActionMessage" Visibility="Collapsed"
                                   FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Left"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</dialogs:GamepadDialogBase>
