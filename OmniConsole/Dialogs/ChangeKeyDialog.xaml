<ContentDialog
    x:Class="OmniConsole.Dialogs.ChangeKeyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground" Color="#25282C"/>
        <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#1A1B1E"/>
        <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="Transparent"/>
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#25282C"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="12" MinWidth="320">
        <StackPanel x:Name="ModifiersPanel" Visibility="Collapsed" Spacing="6">
            <TextBlock x:Uid="GamepadModifiersLabel" FontSize="13"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="ModCtrl"  x:Uid="GamepadModifier_Ctrl"  MinWidth="64"/>
                <ToggleButton x:Name="ModShift" x:Uid="GamepadModifier_Shift" MinWidth="64"/>
                <ToggleButton x:Name="ModAlt"   x:Uid="GamepadModifier_Alt"   MinWidth="64"/>
                <ToggleButton x:Name="ModWin"   x:Uid="GamepadModifier_Win"   MinWidth="64"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock x:Uid="GamepadKeyLabel" FontSize="13"/>
            <ComboBox x:Name="KeyCombo" HorizontalAlignment="Stretch"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
