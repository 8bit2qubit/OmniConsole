<dialogs:GamepadDialogBase
    x:Class="OmniConsole.Dialogs.GamepadMessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:OmniConsole.Dialogs"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Close"
    RequestedTheme="Dark">

    <dialogs:GamepadDialogBase.Resources>
        <ResourceDictionary Source="PhantomDialogStyles.xaml"/>
    </dialogs:GamepadDialogBase.Resources>

    <TextBlock x:Name="BodyText" TextWrapping="Wrap" MinWidth="320" FontSize="14"/>
</dialogs:GamepadDialogBase>
