<ContentDialog
    x:Class="OmniConsole.Dialogs.CopyFromProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="ContentDialogBackground" Color="#25282C"/>
        <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#1A1B1E"/>
        <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="Transparent"/>
        <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="Transparent"/>
        <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#25282C"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="8" MinWidth="320">
        <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="14"/>
        <ComboBox x:Name="ProfileCombo" HorizontalAlignment="Stretch"/>
    </StackPanel>
</ContentDialog>
