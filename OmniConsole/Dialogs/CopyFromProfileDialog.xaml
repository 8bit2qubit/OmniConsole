<dialogs:GamepadDialogBase
    x:Class="OmniConsole.Dialogs.CopyFromProfileDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:OmniConsole.Dialogs"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Primary"
    RequestedTheme="Dark">

    <dialogs:GamepadDialogBase.Resources>
        <ResourceDictionary Source="PhantomDialogStyles.xaml"/>
    </dialogs:GamepadDialogBase.Resources>

    <!-- 固定 Width（非 MinWidth）：AutoSuggestBox 選不同項時 Text 換成長度不一的 label，MinWidth 會被撐大造成
         對話方塊寬度抖動（變瘦變胖）；固定寬度後 AutoSuggestBox Stretch 填滿、長文字在框內水平捲動、對話方塊寬度恆定。 -->
    <StackPanel Spacing="8" Width="440">
        <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="14"/>
        <AutoSuggestBox x:Name="ProfileSuggestBox" HorizontalAlignment="Stretch"/>
    </StackPanel>
</dialogs:GamepadDialogBase>
