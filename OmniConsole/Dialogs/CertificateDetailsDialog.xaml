<dialogs:GamepadDialogBase
    x:Class="OmniConsole.Dialogs.CertificateDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:OmniConsole.Services"
    xmlns:dialogs="using:OmniConsole.Dialogs"
    Style="{StaticResource DefaultContentDialogStyle}"
    DefaultButton="Close"
    RequestedTheme="Dark">

    <dialogs:GamepadDialogBase.Resources>
        <ResourceDictionary Source="PhantomDialogStyles.xaml"/>
    </dialogs:GamepadDialogBase.Resources>

    <StackPanel Spacing="12" MinWidth="480">

        <!-- 含品牌名：改由 code-behind 設值（注入品牌）；保留 Localized.Uid 供社群語言外掛套用。 -->
        <TextBlock x:Name="BodyText" services:Localized.Uid="CertDetailsDialog_Body" FontSize="14"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                   TextWrapping="Wrap"/>

        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8">
            <TextBlock x:Name="ThumbprintText"
                       FontSize="13"
                       FontFamily="Consolas"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       TextWrapping="Wrap"
                       IsTextSelectionEnabled="True"/>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock x:Uid="Label_Source" services:Localized.Uid="Label_Source" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text=": " VerticalAlignment="Center"/>
            <HyperlinkButton x:Name="SourceLink"
                             x:Uid="OpenRepoOnGitHubAccessibleName" services:Localized.Uid="OpenRepoOnGitHubAccessibleName"
                             FontSize="13" FontFamily="Consolas" Padding="0" Margin="0" VerticalAlignment="Center"/>
        </StackPanel>

        <HyperlinkButton x:Name="OpenAuthenticityButton"
                        x:Uid="CertDetailsDialog_OpenAuthenticity" services:Localized.Uid="CertDetailsDialog_OpenAuthenticity"
                        FontSize="13"/>

        <TextBlock x:Name="CopiedHintText"
                   x:Uid="CertDetailsDialog_Copied" services:Localized.Uid="CertDetailsDialog_Copied"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Visibility="Collapsed"/>

    </StackPanel>
</dialogs:GamepadDialogBase>
