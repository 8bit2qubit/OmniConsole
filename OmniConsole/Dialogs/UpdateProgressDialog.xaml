<dialogs:GamepadDialogBase
    x:Class="OmniConsole.Dialogs.UpdateProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:OmniConsole.Dialogs"
    Style="{StaticResource DefaultContentDialogStyle}"
    RequestedTheme="Dark">

    <dialogs:GamepadDialogBase.Resources>
        <ResourceDictionary Source="PhantomDialogStyles.xaml"/>
    </dialogs:GamepadDialogBase.Resources>

    <StackPanel Width="420" Spacing="12">

        <TextBlock x:Name="StatusText" FontSize="14"
                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                   TextWrapping="Wrap"/>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="ProgressBarControl" Grid.Column="0"
                         Minimum="0" Maximum="100" Value="0"
                         VerticalAlignment="Center"/>
            <TextBlock x:Name="ProgressText" Grid.Column="1"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="14" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock x:Name="HintText" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"/>

    </StackPanel>
</dialogs:GamepadDialogBase>
