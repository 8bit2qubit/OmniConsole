<UserControl
    x:Class="OmniConsole.Controls.GamepadProfileEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#25282C"/>

        <Style x:Key="HeaderCardFocusStyle" TargetType="ContentControl">
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="3"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
            <Setter Property="FocusVisualMargin" Value="-3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="700" Margin="0,24,0,24">

            <!-- 頁首卡片：App 名稱 + appId 副文字 + 綁定路徑（僅 Win32 process 類顯示），可被手把焦點落 -->
            <ContentControl Style="{StaticResource HeaderCardFocusStyle}" HorizontalAlignment="Stretch" MinWidth="700"
                            XYFocusDown="{x:Bind BlockNativeGamepadInputSwitch}">
                <StackPanel Padding="16" Spacing="4">
                    <TextBlock x:Name="AppNameText" FontSize="28" FontWeight="Bold"/>
                    <TextBlock x:Name="AppIdText"   FontSize="12" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel x:Name="PathDisplayPanel" Orientation="Vertical" Spacing="2" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock x:Uid="GamepadProfile_PathBoundLabel"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PathHintText"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <!-- 工具列 + BlockNativeGamepadInput 合併群組 -->
            <TextBlock x:Uid="GamepadMappingToolsSection" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel>
                    <!-- BlockNativeGamepadInput 開關 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE785;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="GamepadProfile_BlockNativeGamepadInput_Title" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock x:Uid="GamepadProfile_BlockNativeGamepadInput_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="GamepadProfile_BlockNativeGamepadInput_Note" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="BlockNativeGamepadInputSwitch"
                                      Toggled="BlockNativeGamepadInputSwitch_Toggled"
                                      FlowDirection="RightToLeft"
                                      Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0"/>
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- 工具列 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE713;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="CopyFromButton"     x:Uid="GamepadMappingCopyFromButton"     FontSize="14" Padding="24,8" Click="CopyFromButton_Click"     XYFocusUp="{x:Bind BlockNativeGamepadInputSwitch}"/>
                            <Button x:Name="ClearAllButton"     x:Uid="GamepadMappingClearAllButton"     FontSize="14" Padding="24,8" Click="ClearAllButton_Click"     XYFocusUp="{x:Bind BlockNativeGamepadInputSwitch}"/>
                            <Button x:Name="ResetButton"        x:Uid="GamepadMappingResetButton"        FontSize="14" Padding="24,8" Click="ResetButton_Click"        XYFocusUp="{x:Bind BlockNativeGamepadInputSwitch}"/>
                            <Button x:Name="ResetClassicButton" x:Uid="GamepadMappingResetClassicButton" FontSize="14" Padding="24,8" Click="ResetClassicButton_Click" XYFocusUp="{x:Bind BlockNativeGamepadInputSwitch}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 面鍵群組 -->
            <TextBlock x:Uid="GamepadGroup_FaceButtons" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel Padding="16" Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF093;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_A" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboA" Grid.Column="1" HorizontalAlignment="Stretch" Tag="A" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnA" Grid.Column="2" Tag="A" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF094;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_B" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboB" Grid.Column="1" HorizontalAlignment="Stretch" Tag="B" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnB" Grid.Column="2" Tag="B" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF096;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_X" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboX" Grid.Column="1" HorizontalAlignment="Stretch" Tag="X" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnX" Grid.Column="2" Tag="X" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF095;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_Y" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboY" Grid.Column="1" HorizontalAlignment="Stretch" Tag="Y" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnY" Grid.Column="2" Tag="Y" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 肩鍵 / 板機群組 -->
            <TextBlock x:Uid="GamepadGroup_Shoulders" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel Padding="16" Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF10C;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_LB" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboLB" Grid.Column="1" HorizontalAlignment="Stretch" Tag="LB" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnLB" Grid.Column="2" Tag="LB" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF10D;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_RB" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboRB" Grid.Column="1" HorizontalAlignment="Stretch" Tag="RB" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnRB" Grid.Column="2" Tag="RB" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF10A;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_LT" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboLT" Grid.Column="1" HorizontalAlignment="Stretch" Tag="LT" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnLT" Grid.Column="2" Tag="LT" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF10B;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_RT" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboRT" Grid.Column="1" HorizontalAlignment="Stretch" Tag="RT" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnRT" Grid.Column="2" Tag="RT" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 搖桿按下群組 -->
            <TextBlock x:Uid="GamepadGroup_ThumbButtons" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel Padding="16" Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF108;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_LS" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboLS" Grid.Column="1" HorizontalAlignment="Stretch" Tag="LS" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnLS" Grid.Column="2" Tag="LS" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF109;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_RS" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboRS" Grid.Column="1" HorizontalAlignment="Stretch" Tag="RS" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnRS" Grid.Column="2" Tag="RS" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 搖桿 / 十字鍵群組 -->
            <TextBlock x:Uid="GamepadGroup_Sticks" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel Padding="16" Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF108;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_LStick" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboLStick" Grid.Column="1" HorizontalAlignment="Stretch" Tag="LStick" SelectionChanged="ActionCombo_SelectionChanged"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF109;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_RStick" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboRStick" Grid.Column="1" HorizontalAlignment="Stretch" Tag="RStick" SelectionChanged="ActionCombo_SelectionChanged"/>
                    </Grid>
                    <!-- DPad 主行：選 Arrows / WASD / Numpad / Custom / None -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF10E;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_DPad" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboDPad" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ComboDPad_SelectionChanged"/>
                    </Grid>

                    <!-- DPad 自訂模式 4 子列（Visibility 由 code-behind 控制） -->
                    <Grid x:Name="DPadCustomRowUp" Visibility="Collapsed" Margin="24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE0E4;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="18"/>
                            <TextBlock x:Uid="GamepadInput_DPadUp" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboDPadUp" Grid.Column="1" HorizontalAlignment="Stretch" Tag="DPadUp" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnDPadUp" Grid.Column="2" Tag="DPadUp" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <Grid x:Name="DPadCustomRowDown" Visibility="Collapsed" Margin="24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE0E5;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="18"/>
                            <TextBlock x:Uid="GamepadInput_DPadDown" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboDPadDown" Grid.Column="1" HorizontalAlignment="Stretch" Tag="DPadDown" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnDPadDown" Grid.Column="2" Tag="DPadDown" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <Grid x:Name="DPadCustomRowLeft" Visibility="Collapsed" Margin="24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE0E2;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="18"/>
                            <TextBlock x:Uid="GamepadInput_DPadLeft" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboDPadLeft" Grid.Column="1" HorizontalAlignment="Stretch" Tag="DPadLeft" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnDPadLeft" Grid.Column="2" Tag="DPadLeft" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <Grid x:Name="DPadCustomRowRight" Visibility="Collapsed" Margin="24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE0E3;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="18"/>
                            <TextBlock x:Uid="GamepadInput_DPadRight" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboDPadRight" Grid.Column="1" HorizontalAlignment="Stretch" Tag="DPadRight" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnDPadRight" Grid.Column="2" Tag="DPadRight" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
