<Page
    x:Class="OmniConsole.Pages.Settings.AdvancedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:OmniConsole.Services"
    xmlns:local="using:OmniConsole.Pages.Settings">

    <Page.Resources>
        <!-- 跨頁共用：CardBackgroundFillColorDefaultBrush（#25282C）。 -->
        <ResourceDictionary Source="PhantomViewStyles.xaml"/>
    </Page.Resources>

    <!-- 捲動內收：頁面內建 ScrollViewer，內容超出可視範圍時可捲動。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- 標題/副標滿版置中，不受卡片 700 寬度限制；左右 Margin 24 避開右側捲軸（撐滿時不壓到 ScrollBar）。 -->
            <TextBlock x:Uid="AdvancedTitle" services:Localized.Uid="AdvancedTitle" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"/>
            <TextBlock x:Uid="AdvancedDescription" services:Localized.Uid="AdvancedDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"/>
            <!-- 卡片內容群組：維持 700 窄欄 -->
            <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="700" Margin="0,8,0,0">

            <!-- 更新分類標題 -->
            <TextBlock x:Uid="AdvancedSection_Updates" services:Localized.Uid="AdvancedSection_Updates" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,0,0,0"/>

            <!-- 更新群組卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel>
                    <!-- 版本號與檢查更新 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE946;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Uid="VersionInfo_Title" services:Localized.Uid="VersionInfo_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                <TextBlock x:Name="AdvancedVersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdateCheckStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" Visibility="Collapsed"/>
                            <StackPanel x:Name="DeveloperModeWarningPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <TextBlock x:Name="DeveloperModeWarningText" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <HyperlinkButton x:Name="DeveloperModeOpenSettingsButton" x:Uid="DeveloperMode_OpenSettings" services:Localized.Uid="DeveloperMode_OpenSettings" Click="DeveloperModeOpenSettings_Click" FontSize="12" Padding="4,2"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="DownloadInstallButton" x:Uid="DownloadInstallButton" services:Localized.Uid="DownloadInstallButton"
                                    Click="DownloadInstallButton_Click"
                                    Visibility="Collapsed"
                                    XYFocusDown="{x:Bind AutoUpdateCheckSwitch}"
                                    FontSize="14" Padding="24,8"/>
                            <Button x:Name="CheckForUpdatesButton" x:Uid="CheckForUpdatesButton" services:Localized.Uid="CheckForUpdatesButton"
                                    Click="CheckForUpdatesButton_Click"
                                    FontSize="14" Padding="24,8"/>
                            <ProgressRing x:Name="CheckUpdateProgressRing"
                                          IsActive="False" Visibility="Collapsed"
                                          Width="20" Height="20"/>
                        </StackPanel>
                    </Grid>

                    <!-- 下載進度 -->
                    <Grid x:Name="DownloadProgressPanel" Visibility="Collapsed" Padding="16,0,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0"
                                     VerticalAlignment="Center"/>
                        <TextBlock x:Name="DownloadProgressText" Grid.Column="1"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- 自動檢查更新 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE895;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="AutoUpdateCheck_Title" services:Localized.Uid="AutoUpdateCheck_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="AutoUpdateCheck_Description" services:Localized.Uid="AutoUpdateCheck_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="AutoUpdateCheckSwitch"
                                      Toggled="AutoUpdateCheckSwitch_Toggled"
                                      FlowDirection="RightToLeft"
                                      Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Steam 分類標題 -->
            <TextBlock x:Uid="AdvancedSection_Steam" services:Localized.Uid="AdvancedSection_Steam" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,0,0,0"/>

            <!-- Steam 群組卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel>
                    <!-- PhantomKey 手把輸入，已改為 FSE 常駐，保留標題/描述作為以下設定的區段說明，僅註解開關 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE90C;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="PhantomKeySetting_Title" services:Localized.Uid="PhantomKeySetting_Title" services:FluentIconTextHelper.AutoFormat="True" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="PhantomKeySetting_Description" services:Localized.Uid="PhantomKeySetting_Description" services:FluentIconTextHelper.AutoFormat="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!--
                        <ToggleSwitch x:Name="UsePhantomKeySwitch"
                                      Toggled="UsePhantomKeySwitch_Toggled"
                                      FlowDirection="RightToLeft"
                                      Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                        -->
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- Steam In-Game Overlay -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xEA5B;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="SteamInGameOverlaySetting_Title" services:Localized.Uid="SteamInGameOverlaySetting_Title" services:FluentIconTextHelper.AutoFormat="True" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="SteamInGameOverlaySetting_Description" services:Localized.Uid="SteamInGameOverlaySetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="SteamInGameOverlaySetting_Note" services:Localized.Uid="SteamInGameOverlaySetting_Note" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="UsePhantomKeySteamInGameOverlaySwitch"
                                      Toggled="UsePhantomKeySteamInGameOverlaySwitch_Toggled"
                                      FlowDirection="RightToLeft"
                                      Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 貓又分類標題 -->
            <TextBlock x:Uid="AdvancedSection_Nekomata" services:Localized.Uid="AdvancedSection_Nekomata" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,0,0,0"/>

            <!-- 貓又群組卡片：手把滑鼠模式 / 控制器版面配置 / 游標速度 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel>
                    <!-- Gamepad Mouse Mode 主開關 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <PathIcon Data="F1 M4.671 11.142C3.298 13.201 2.611 16.634 2.611 19.495C2.611 22.127 3.298 23.5 5.472 23.5L7.074 23.5C7.303 22.47 8.218 22.47 8.447 23.5L10.621 23.5C12.452 23.5 13.139 22.127 13.139 19.495C13.139 16.634 12.452 13.201 11.079 11.142ZM2.726 0.637C2.451 0.5 2.108 0.706 2.108 1.049L2.451 4.001C1.558 4.894 1.009 6.061 1.009 7.366C1.009 10.387 4.099 12.858 7.875 12.858C11.651 12.858 14.741 10.387 14.741 7.366C14.741 6.061 14.191 4.894 13.299 4.001L13.642 1.049C13.676 0.706 13.299 0.5 13.024 0.637L10.552 2.285C9.729 2.01 8.836 1.873 7.875 1.873C6.914 1.873 6.021 2.01 5.197 2.285L2.726 0.637ZM4.854 6.954C5.197 6.954 5.815 7.297 5.815 7.709C5.815 8.121 5.197 8.464 4.854 8.464C4.511 8.464 4.236 8.121 4.236 7.709C4.236 7.297 4.511 6.954 4.854 6.954ZM10.896 6.954C11.239 6.954 11.514 7.297 11.514 7.709C11.514 8.121 11.239 8.464 10.896 8.464C10.552 8.464 9.935 8.121 9.935 7.709C9.935 7.297 10.552 6.954 10.896 6.954ZM7.875 8.739C8.355 8.739 8.767 8.945 8.767 9.288C8.767 9.563 8.355 9.769 7.875 9.769C7.394 9.769 6.982 9.563 6.982 9.288C6.982 8.945 7.394 8.739 7.875 8.739ZM11.193 22.585C14.969 22.813 17.258 20.296 17.83 16.863C18.173 14.803 17.83 12.515 16.8 10.684C16.686 10.455 16.4 10.455 16.285 10.684C15.427 12.286 15.828 14.575 15.542 16.52C15.084 19.381 13.253 20.868 11.079 21.097ZM11.765 23.386C15.542 23.5 19.203 22.241 21.263 19.381C22.293 17.779 22.865 15.948 22.979 14.231C22.991 13.945 22.636 13.774 22.464 14.025C21.892 15.719 21.263 17.435 19.947 18.923C18.173 20.925 15.427 21.898 11.937 21.726Z" Width="24" Height="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="GamepadMappingModeSetting_Title" services:Localized.Uid="GamepadMappingModeSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="GamepadMappingModeSetting_Description" services:Localized.Uid="GamepadMappingModeSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="GamepadMappingModeSetting_Note" services:Localized.Uid="GamepadMappingModeSetting_Note" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <!-- 內建廠商映射機種的兩則說明，依 Pro 授權擇一顯示 -->
                            <TextBlock x:Name="MouseModeBuiltInMappingNoteText" x:Uid="GamepadMappingModeSetting_BuiltInMappingNote" services:Localized.Uid="GamepadMappingModeSetting_BuiltInMappingNote" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="MouseModeBuiltInMappingProNoteText" x:Uid="GamepadMappingModeSetting_BuiltInMappingProNote" services:Localized.Uid="GamepadMappingModeSetting_BuiltInMappingProNote" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="MouseModeSwitch"
                                      Toggled="MouseModeSwitch_Toggled"
                                      FlowDirection="RightToLeft"
                                      Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                    </Grid>

                    <!-- 提權程式支援（Pro 專屬，貓又模式開關下方一列）。整段含分隔線一起顯隱，未持 Pro 時 Collapsed。 -->
                    <StackPanel x:Name="ElevatedAppSupportSection" Visibility="Collapsed">
                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>
                        <Grid Padding="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE7EF;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Uid="ElevatedAppSupportSetting_Title" services:Localized.Uid="ElevatedAppSupportSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                <TextBlock x:Uid="ElevatedAppSupportSetting_Description" services:Localized.Uid="ElevatedAppSupportSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button x:Name="ElevatedAppSupportButton" Grid.Column="2"
                                    Click="ElevatedAppSupportButton_Click"
                                    FontSize="14" Padding="24,8" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- Mouse Mode 版面配置切換 (OmniNav / Classic) -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE8AB;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="ControllerLayoutPresetSetting_Title" services:Localized.Uid="ControllerLayoutPresetSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="ControllerLayoutPresetSetting_Description" services:Localized.Uid="ControllerLayoutPresetSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 項目由 code-behind 動態填入（Content 走 .Loc 在地化），不用 XAML 宣告 x:Uid。同 CursorSpeedCombo。
                             「編輯…」只在下拉選單選了「自訂」時出現。疊在下拉選單「下方」而不是並排。 -->
                        <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="8"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                            <ComboBox x:Name="MouseModeLayoutCombo"
                                      SelectionChanged="MouseModeLayoutCombo_SelectionChanged"
                                      DropDownClosed="MouseModeLayoutCombo_DropDownClosed"
                                      MinWidth="120" HorizontalAlignment="Stretch"/>
                            <Button x:Name="EditCustomLayoutButton"
                                    x:Uid="ControllerLayoutPresetEditButton" services:Localized.Uid="ControllerLayoutPresetEditButton"
                                    Click="EditCustomLayoutButton_Click"
                                    FontSize="14" Padding="24,8" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- Cursor Speed 下拉選單 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE7C9;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="CursorSpeedSetting_Title" services:Localized.Uid="CursorSpeedSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="CursorSpeedSetting_Description" services:Localized.Uid="CursorSpeedSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ComboBox x:Name="CursorSpeedCombo" Grid.Column="2"
                                  SelectionChanged="CursorSpeedCombo_SelectionChanged"
                                  MinWidth="120" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 疊加層分類標題（Pro 專屬） -->
            <StackPanel x:Name="OverlaySection" Spacing="16" Visibility="Collapsed">
            <TextBlock x:Uid="AdvancedSection_Overlay" services:Localized.Uid="AdvancedSection_Overlay" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,0,0,0"/>

            <!-- 疊加層群組卡片：螢幕顯示 / 統計資訊 / 文字陰影 / 顯示大小 / 幀率限制 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel>
                    <!-- 螢幕顯示總開關 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE7F4;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="OverlayOsdSetting_Title" services:Localized.Uid="OverlayOsdSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="OverlayOsdSetting_Description" services:Localized.Uid="OverlayOsdSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                            <!-- 三則提示各自對應一種不可用的原因，同時只會出現一則 -->
                            <TextBlock x:Name="OverlayElevationNoteText" x:Uid="OverlaySetting_ElevationNote" services:Localized.Uid="OverlaySetting_ElevationNote" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="OverlayRtssNoteText" x:Uid="OverlaySetting_RtssNote" services:Localized.Uid="OverlaySetting_RtssNote" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="OverlayRtssStoppedNoteText" x:Uid="OverlaySetting_RtssStoppedNote" services:Localized.Uid="OverlaySetting_RtssStoppedNote" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="OverlayOsdSwitch"
                                      Toggled="OverlayOsdSwitch_Toggled"
                                      FlowDirection="RightToLeft"
                                      Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- 統計資訊 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE9D9;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="OverlayStatSetting_Title" services:Localized.Uid="OverlayStatSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="OverlayStatSetting_Description" services:Localized.Uid="OverlayStatSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="OverlayStatSwitch"
                                      Toggled="OverlayStatSwitch_Toggled"
                                      FlowDirection="RightToLeft"
                                      Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- 文字陰影 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE7E6;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="OverlayShadowSetting_Title" services:Localized.Uid="OverlayShadowSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="OverlayShadowSetting_Description" services:Localized.Uid="OverlayShadowSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="OverlayShadowSwitch"
                                      Toggled="OverlayShadowSwitch_Toggled"
                                      FlowDirection="RightToLeft"
                                      Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- 顯示大小下拉選單 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE8A3;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="OverlayZoomSetting_Title" services:Localized.Uid="OverlayZoomSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="OverlayZoomSetting_Description" services:Localized.Uid="OverlayZoomSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 項目由 code-behind 動態填入 -->
                        <ComboBox x:Name="OverlayZoomCombo" Grid.Column="2"
                                  SelectionChanged="OverlayZoomCombo_SelectionChanged"
                                  MinWidth="120" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- 幀率限制下拉選單 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE916;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="OverlayFpsLimitSetting_Title" services:Localized.Uid="OverlayFpsLimitSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="OverlayFpsLimitSetting_Description" services:Localized.Uid="OverlayFpsLimitSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ComboBox x:Name="OverlayFpsLimitCombo" Grid.Column="2"
                                  SelectionChanged="OverlayFpsLimitCombo_SelectionChanged"
                                  MinWidth="120" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Xbox 模式 (FSE) 分類標題 -->
            <StackPanel x:Name="FseDialogSection" Spacing="16" Visibility="Collapsed">
            <TextBlock x:Uid="AdvancedSection_Fse" services:Localized.Uid="AdvancedSection_Fse" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,0,0,0"/>

            <!-- Xbox 模式 (FSE) 群組卡片：進入時的動作 / 返回桌面時的確認 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel>
                    <!-- 進入 Xbox 模式時的動作 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE740;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="FseEnterConfirmSetting_Title" services:Localized.Uid="FseEnterConfirmSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="FseEnterConfirmSetting_Description" services:Localized.Uid="FseEnterConfirmSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                            <!-- 選擇重新啟動時才顯示的補充說明 -->
                            <TextBlock x:Name="FseEnterConfirmNoteText" x:Uid="FseEnterConfirmSetting_Note" services:Localized.Uid="FseEnterConfirmSetting_Note" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- 項目由 code-behind 動態填入（Content 走 .Loc 在地化），不用 XAML 宣告 x:Uid。同 CursorSpeedCombo。 -->
                        <ComboBox x:Name="FseEnterConfirmCombo" Grid.Column="2"
                                  SelectionChanged="FseEnterConfirmCombo_SelectionChanged"
                                  Width="280" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- 返回 Windows 桌面前的確認對話方塊 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE73F;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="FseExitConfirmSetting_Title" services:Localized.Uid="FseExitConfirmSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="FseExitConfirmSetting_Description" services:Localized.Uid="FseExitConfirmSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="FseExitConfirmSwitch"
                                      Toggled="FseExitConfirmSwitch_Toggled"
                                      FlowDirection="RightToLeft"
                                      Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                    </Grid>
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- 介面顯示分類標題 -->
            <TextBlock x:Uid="AdvancedSection_Display" services:Localized.Uid="AdvancedSection_Display" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,0,0,0"/>

            <!-- 介面顯示群組卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel>
                    <!-- 背景材質 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE790;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="BackgroundMaterialSetting_Title" services:Localized.Uid="BackgroundMaterialSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="BackgroundMaterialSetting_Description" services:Localized.Uid="BackgroundMaterialSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="BackgroundMaterialSetting_Note" services:Localized.Uid="BackgroundMaterialSetting_Note" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 項目由 code-behind 動態填入（Content 走 .Loc 在地化），不用 XAML 宣告 x:Uid。同 CursorSpeedCombo。 -->
                        <!-- 固定 Width（非 MinWidth）：避免長項撐寬導致展開 popup 對齊跑掉、偏移右側。同 LanguageCombo 慣例。 -->
                        <ComboBox x:Name="BackgroundMaterialCombo" Grid.Column="2"
                                  SelectionChanged="BackgroundMaterialCombo_SelectionChanged"
                                  Width="180" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- 顯示語言 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xF2B7;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="LanguageSetting_Title" services:Localized.Uid="LanguageSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="LanguageSetting_Description" services:Localized.Uid="LanguageSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 項目由 code-behind 動態填入、不在 XAML 宣告（ComboBox i18n 慣例，同 CursorSpeedCombo）。 -->
                        <!-- 固定 Width（非 MinWidth）：避免長語言項撐寬導致展開 popup 對齊跑掉；超長項在收合框截斷（…），展開後完整顯示。 -->
                        <ComboBox x:Name="LanguageCombo" Grid.Column="2"
                                  SelectionChanged="LanguageCombo_SelectionChanged"
                                  Width="280" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- 管理社群語言 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE774;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="ManageLanguagesSetting_Title" services:Localized.Uid="ManageLanguagesSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="ManageLanguagesSetting_Description" services:Localized.Uid="ManageLanguagesSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button x:Name="ManageLanguagesButton" Grid.Column="2"
                                x:Uid="ManageLanguagesButton" services:Localized.Uid="ManageLanguagesButton"
                                Click="ManageLanguagesButton_Click"
                                FontSize="14" Padding="24,8" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 介面音效分類標題 -->
            <TextBlock x:Uid="AdvancedSection_Sound" services:Localized.Uid="AdvancedSection_Sound" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,0,0,0"/>

            <!-- 介面音效群組卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel>
                    <!-- 導覽音效 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE995;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="NavigationSoundsSetting_Title" services:Localized.Uid="NavigationSoundsSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="NavigationSoundsSetting_Description" services:Localized.Uid="NavigationSoundsSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="NavigationSoundsSwitch"
                                      Toggled="NavigationSoundsSwitch_Toggled"
                                      FlowDirection="RightToLeft"
                                      Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--
                Game Bar 進階設定（媒體櫃按鈕開啟設定 / Passthrough）暫時隱藏：
                自 v1.9.0.0 起，OmniCharm 小工具按鈕已可直接進入 Xbox 媒體櫃；
                而 Passthrough 目前僅 Xbox 平台有對應 URI，其它平台尚未發現可用入口，
                開放給使用者調整反而容易踩雷（誤設後會無法從 Game Bar 媒體櫃進入 OmniConsole 設定介面）。
                因此 UI 暫時隱藏，強制走 SettingsService 的預設值；待開發人員模式頁完工後再搬移過去。
                還原時注意：PassthroughSetting_Description 含品牌名，還原啟用後須比照其他含品牌控制項
                改由 code-behind 設值（見 ApplyBrandedTitles），否則品牌佔位會顯示字面。
                （XAML 不支援巢狀註解，原本各小節的 <!~~ Game Bar 分類標題 ~~> /
                  <!~~ Game Bar 群組卡片 ~~> / <!~~ 媒體櫃按鈕開啟設定 ~~> /
                  <!~~ 分隔線 ~~> / <!~~ 直接導向平台 ~~> 子註解，於還原時依下列順序補回原位。）

            <TextBlock x:Uid="AdvancedSection_GameBar" services:Localized.Uid="AdvancedSection_GameBar" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,0,0,0"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel>
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE8F1;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="GameBarLibrarySetting_Title" services:Localized.Uid="GameBarLibrarySetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="GameBarLibrarySetting_Description" services:Localized.Uid="GameBarLibrarySetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="UseGameBarLibrarySwitch" x:Uid="UseGameBarLibrarySwitch" services:Localized.Uid="UseGameBarLibrarySwitch"
                                      Toggled="UseGameBarLibrarySwitch_Toggled"
                                      FlowDirection="RightToLeft"
                                      Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                    </Grid>

                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="&#xE71B;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="PassthroughSetting_Title" services:Localized.Uid="PassthroughSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock x:Uid="PassthroughSetting_Description" services:Localized.Uid="PassthroughSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="PassthroughSetting_Note" services:Localized.Uid="PassthroughSetting_Note" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="EnablePassthroughSwitch" x:Uid="EnablePassthroughSwitch" services:Localized.Uid="EnablePassthroughSwitch"
                                      Toggled="EnablePassthroughSwitch_Toggled"
                                      FlowDirection="RightToLeft"
                                      Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                    </Grid>
                </StackPanel>
            </Border>
            -->

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
