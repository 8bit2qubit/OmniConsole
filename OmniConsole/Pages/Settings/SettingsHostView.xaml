<Page
    x:Class="OmniConsole.Pages.Settings.SettingsHostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OmniConsole.Models"
    xmlns:services="using:OmniConsole.Services"
    NavigationCacheMode="Enabled">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <!-- 群組 1（設定導覽頁面切換）已收斂為單一 SettingsContentFrame、純 Frame.Navigate 切頁（無 Visibility 顯隱）。 -->

            <!-- 群組 2（手把映射清單 vs 編輯器切換）已改由 GamepadMappingHostView 內層 Frame 控制 -->

            <!-- 群組 3（General 頁內容 VSM）已隨 General 內容搬進 GeneralHostView 及其子頁 -->

            <!-- 群組 4（關於頁雙欄/單欄版型 VSM）已隨關於頁內容搬進 AboutView -->

            <!-- 群組 5：底部手把提示列的按鍵圖示（依頁面與索引標籤狀態組合） -->
            <VisualStateGroup x:Name="GamepadHints">
                <!-- NonGeneralPage：預設狀態，LBRB/Y/X 提示預設均 Collapsed -->
                <VisualState x:Name="NonGeneralPage"/>
                <!-- SystemTab：General 頁 + 系統索引標籤，顯示 LB/RB 切換提示 -->
                <!-- GamepadHintMenu 由 code-behind 根據 FseService.IsActive() 動態控制，不在此設定 -->
                <VisualState x:Name="SystemTab">
                    <VisualState.Setters>
                        <Setter Target="GamepadHintLBRB.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- UserTabNoConsent：General 頁 + 使用者索引標籤 + 未接受免責聲明，顯示 LB/RB 但無 Y/X/Menu -->
                <VisualState x:Name="UserTabNoConsent">
                    <VisualState.Setters>
                        <Setter Target="GamepadHintLBRB.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- UserTabWithConsent：General 頁 + 使用者索引標籤 + 已接受，顯示 LB/RB + Y（新增）+ X（編輯）-->
                <!-- GamepadHintMenu 由 code-behind 根據 FseService.IsActive() 動態控制，不在此設定 -->
                <VisualState x:Name="UserTabWithConsent">
                    <VisualState.Setters>
                        <Setter Target="GamepadHintLBRB.Visibility" Value="Visible"/>
                        <Setter Target="GamepadHintY.Visibility" Value="Visible"/>
                        <Setter Target="GamepadHintX.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- GamepadMappingListTab：清單頁狀態，X/LB/RB/Y 由 code-behind 控制 -->
                <VisualState x:Name="GamepadMappingListTab"/>
                <!-- GamepadMappingEditorTab：編輯器頁，B 改為「儲存並返回」，隱藏一般退出提示 -->
                <VisualState x:Name="GamepadMappingEditorTab">
                    <VisualState.Setters>
                        <Setter Target="GamepadHintExit.Visibility" Value="Collapsed"/>
                        <Setter Target="GamepadHintBSaveReturn.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- 設定模式：多頁面導覽介面 -->
        <!-- 掌機最佳化：預設隱藏導覽選單，僅顯示漢堡按鈕以最大化內容空間 -->
        <NavigationView x:Name="SettingsNav"
                        PaneDisplayMode="LeftMinimal"
                        IsPaneOpen="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="340"
                        SelectionChanged="SettingsNav_SelectionChanged"
                        PaneOpening="SettingsNav_PaneOpening"
                        PaneClosing="SettingsNav_PaneClosing"
                        XYFocusKeyboardNavigation="Enabled">

            <!-- 掌機最佳化：覆寫漢堡選單按鈕樣式以符合 64px 導覽列寬度 -->
            <NavigationView.PaneToggleButtonStyle>
                <Style TargetType="Button"
                       BasedOn="{StaticResource PaneToggleButtonStyle}">
                    <!-- 增大按鈕點選區域並移除內距，確保在 64x64 空間中完全填滿 -->
                    <Setter Property="MinWidth" Value="64"/>
                    <Setter Property="MinHeight" Value="64"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <!-- 自訂樣板以確保圖示在較大按鈕中精確置中，並適配 WinUI 3 的視覺狀態 -->
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="RootGrid"
                                      Background="{TemplateBinding Background}"
                                      CornerRadius="{TemplateBinding CornerRadius}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="RootGrid.Background" Value="{ThemeResource NavigationViewButtonBackgroundPointerOver}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="RootGrid.Background" Value="{ThemeResource NavigationViewButtonBackgroundPressed}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="RootGrid.Background" Value="{ThemeResource NavigationViewButtonBackgroundDisabled}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <!-- 手動定義漢堡選單圖示 (Glyph E700)，確保其在自訂樣板中精確置中 -->
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Glyph="&#xE700;"
                                              FontSize="24"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </NavigationView.PaneToggleButtonStyle>

            <!-- 佔位空間：解決漢堡按鈕與下方導覽項目重疊的問題 (維持 64px 高度一致性) -->
            <NavigationView.PaneHeader>
                <Grid Height="64"/>
            </NavigationView.PaneHeader>

            <NavigationView.Resources>
                <!-- 掌機最佳化：加大導覽列寬度與項目高度 -->
                <x:Double x:Key="NavigationViewCompactPaneLength">64</x:Double>
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">64</x:Double>

                <!-- 選取指示器寬度與高度 -->
                <x:Double x:Key="NavigationViewSelectionIndicatorWidth">6</x:Double>
                <x:Double x:Key="NavigationViewSelectionIndicatorHeight">24</x:Double>

                <!-- 內容區背景透明，讓底層背景材質透出。
                     面板主背景 NavigationViewDefaultPaneBackground 不在此設，由 BackgroundMaterialService 於 App 啟動時
                     依背景材質覆寫（控制項層級就近覆寫會蓋過 App 級的依材質切換）。 -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
            </NavigationView.Resources>

            <!-- 主要導覽項目 -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_General" services:Localized.Uid="Nav_General" Tag="General" IsSelected="True" FontSize="24">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF0E2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Advanced" services:Localized.Uid="Nav_Advanced" Tag="Advanced" FontSize="24">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_GamepadMapping" services:Localized.Uid="Nav_GamepadMapping" Tag="GamepadMapping" FontSize="24">
                    <NavigationViewItem.Icon>
                        <PathIcon Data="F1 M4.671 11.142C3.298 13.201 2.611 16.634 2.611 19.495C2.611 22.127 3.298 23.5 5.472 23.5L7.074 23.5C7.303 22.47 8.218 22.47 8.447 23.5L10.621 23.5C12.452 23.5 13.139 22.127 13.139 19.495C13.139 16.634 12.452 13.201 11.079 11.142ZM2.726 0.637C2.451 0.5 2.108 0.706 2.108 1.049L2.451 4.001C1.558 4.894 1.009 6.061 1.009 7.366C1.009 10.387 4.099 12.858 7.875 12.858C11.651 12.858 14.741 10.387 14.741 7.366C14.741 6.061 14.191 4.894 13.299 4.001L13.642 1.049C13.676 0.706 13.299 0.5 13.024 0.637L10.552 2.285C9.729 2.01 8.836 1.873 7.875 1.873C6.914 1.873 6.021 2.01 5.197 2.285L2.726 0.637ZM4.854 6.954C5.197 6.954 5.815 7.297 5.815 7.709C5.815 8.121 5.197 8.464 4.854 8.464C4.511 8.464 4.236 8.121 4.236 7.709C4.236 7.297 4.511 6.954 4.854 6.954ZM10.896 6.954C11.239 6.954 11.514 7.297 11.514 7.709C11.514 8.121 11.239 8.464 10.896 8.464C10.552 8.464 9.935 8.121 9.935 7.709C9.935 7.297 10.552 6.954 10.896 6.954ZM7.875 8.739C8.355 8.739 8.767 8.945 8.767 9.288C8.767 9.563 8.355 9.769 7.875 9.769C7.394 9.769 6.982 9.563 6.982 9.288C6.982 8.945 7.394 8.739 7.875 8.739ZM11.193 22.585C14.969 22.813 17.258 20.296 17.83 16.863C18.173 14.803 17.83 12.515 16.8 10.684C16.686 10.455 16.4 10.455 16.285 10.684C15.427 12.286 15.828 14.575 15.542 16.52C15.084 19.381 13.253 20.868 11.079 21.097ZM11.765 23.386C15.542 23.5 19.203 22.241 21.263 19.381C22.293 17.779 22.865 15.948 22.979 14.231C22.991 13.945 22.636 13.774 22.464 14.025C21.892 15.719 21.263 17.435 19.947 18.923C18.173 20.925 15.427 21.898 11.937 21.726Z" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Troubleshoot" services:Localized.Uid="Nav_Troubleshoot" Tag="Troubleshoot" FontSize="24">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Pro" services:Localized.Uid="Nav_Pro" Tag="Pro" FontSize="24">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF4A5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Grid Margin="64,24,64,80">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 更新通知 InfoBar（佔版面固定區塊） -->
                    <InfoBar x:Name="SettingsUpdateInfoBar"
                             Grid.Row="0"
                             IsOpen="False" IsClosable="False"
                             Severity="Informational"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,16"/>

                    <!-- 設定內容單一導覽 Frame：分頁切換一律 Frame.Navigate 目標頁（切走即銷毀），純一條軌道、無 Visibility 顯隱。
                         各頁捲動由各自頁面內部自理（Advanced/Troubleshoot 已內收 ScrollViewer）。 -->
                    <Frame x:Name="SettingsContentFrame" Grid.Row="1"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Grid>
            </NavigationView.Content>

            <!-- 底部選單項目：版本號與作者顯示（不可選取）+ 關於頁入口（可選取） -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="VersionItem" IsEnabled="False" SelectsOnInvoked="False">
                    <NavigationViewItem.Content>
                        <StackPanel>
                            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="20"/>
                            <TextBlock Text="8bit2qubit (野理)" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="16"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_About" services:Localized.Uid="Nav_About" Tag="About" FontSize="24">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
        </NavigationView>

        <!-- 全域手把按鍵提示列：固定於底部，設定介面所有頁面共用 -->
        <StackPanel x:Name="GamepadHintBar"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24" Spacing="32"
                    IsHitTestVisible="True">
            <!-- LB/RB 索引標籤切換提示 -->
            <StackPanel x:Name="GamepadHintLBRB" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                <FontIcon Glyph="&#xF10C;" FontSize="22"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"/>
                <FontIcon Glyph="&#xF10D;" FontSize="22"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock x:Uid="GamepadHint_SwitchTab" services:Localized.Uid="GamepadHint_SwitchTab" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xF093;" FontSize="22"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"/>
                <TextBlock x:Uid="GamepadHint_Select" services:Localized.Uid="GamepadHint_Select" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <!-- Y 鍵新增提示（僅使用者索引標籤時顯示，滑鼠可點選） -->
            <Button x:Name="GamepadHintY" Visibility="Collapsed"
                    Click="AddPlatformHintButton_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0" MinWidth="0" MinHeight="0"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF095;" FontSize="22"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="GamepadHint_Add" services:Localized.Uid="GamepadHint_Add" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- X 鍵編輯提示（僅使用者索引標籤時顯示，滑鼠可點選） -->
            <Button x:Name="GamepadHintX" Visibility="Collapsed"
                    Click="EditPlatformHintButton_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0" MinWidth="0" MinHeight="0"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF096;" FontSize="22"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="GamepadHint_Edit" services:Localized.Uid="GamepadHint_Edit" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- Menu 鍵直接啟動提示（FSE 模式中 + 系統索引標籤或已接受自訂平台同意才顯示，滑鼠可點選） -->
            <Button x:Name="GamepadHintMenu" Visibility="Collapsed"
                    Click="LaunchPlatformHintButton_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0" MinWidth="0" MinHeight="0"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEDE3;" FontSize="22"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="GamepadHint_Launch" services:Localized.Uid="GamepadHint_Launch" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- X 鍵：刪除（清單頁=刪選中項；編輯器頁=刪目前 profile）。Visibility 由 code-behind 控制 -->
            <Button x:Name="GamepadHintXDelete" Visibility="Collapsed"
                    Click="DeleteProfileHintButton_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0" MinWidth="0" MinHeight="0"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF096;" FontSize="22"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="GamepadHint_DeleteProfile" services:Localized.Uid="GamepadHint_DeleteProfile" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- LB/RB 跳頁提示（手把映射清單頁顯示，由 VSM 控制 Visibility） -->
            <StackPanel x:Name="GamepadHintLBRBPaging" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                <FontIcon Glyph="&#xF10C;" FontSize="22"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"/>
                <FontIcon Glyph="&#xF10D;" FontSize="22"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock x:Uid="GamepadHint_SwitchPage" services:Localized.Uid="GamepadHint_SwitchPage" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <!-- Y 鍵：搜尋方塊與清單之間切換焦點（手把映射清單頁顯示，滑鼠可點選 = 將焦點移到搜尋方塊） -->
            <Button x:Name="GamepadHintYSearchToggle" Visibility="Collapsed"
                    Click="SearchToggleHintButton_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0" MinWidth="0" MinHeight="0"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF095;" FontSize="22"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="GamepadHint_Search" services:Localized.Uid="GamepadHint_Search" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- B 鍵：編輯器頁的「儲存並返回」（取代一般退出提示） -->
            <Button x:Name="GamepadHintBSaveReturn" Visibility="Collapsed"
                    Click="SaveProfileHintButton_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0" MinWidth="0" MinHeight="0"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF094;" FontSize="22"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="GamepadHint_SaveReturn" services:Localized.Uid="GamepadHint_SaveReturn" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- 滑鼠可點選退出，手把 B 鍵也觸發同一動作 -->
            <Button x:Name="GamepadHintExit" Click="ExitHintButton_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0" MinWidth="0" MinHeight="0"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF094;" FontSize="22"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="GamepadHint_Exit" services:Localized.Uid="GamepadHint_Exit" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
