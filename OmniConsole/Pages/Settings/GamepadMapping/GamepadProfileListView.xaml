<Page
    x:Class="OmniConsole.Pages.Settings.GamepadMapping.GamepadProfileListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:OmniConsole.Services"
    xmlns:local="using:OmniConsole.Pages.Settings.GamepadMapping">

    <Page.Resources>
        <ResourceDictionary>
            <!-- 跨頁共用：CardBackgroundFillColorDefaultBrush（#25282C）。 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../PhantomViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- 關掉 ListViewItem 左側 selection accent bar，焦點視覺僅保留白框。 -->
            <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
        </ResourceDictionary>
    </Page.Resources>

    <!-- 三段式版面：標題區(Auto) / 工具列(Auto) / 清單區(*) 撐滿剩餘高度。
         外層不再用 ScrollViewer，捲動權交回 ListView 自身，虛擬化才會生效，
         LastVisibleIndex 才回報真實可見項數（LB/RB 跳頁計算依賴此值）。 -->
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0：標題區（釘住不捲） -->
        <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="24,0">
                <PathIcon Data="F1 M7.007 16.713C4.947 19.802 3.917 24.951 3.917 29.242C3.917 33.191 4.947 35.25 8.208 35.25L10.611 35.25C10.954 33.705 12.327 33.705 12.67 35.25L15.931 35.25C18.678 35.25 19.709 33.191 19.709 29.242C19.709 24.951 18.678 19.802 16.619 16.713ZM4.089 0.956C3.676 0.75 3.162 1.059 3.162 1.573L3.676 6.002C2.337 7.341 1.513 9.091 1.513 11.049C1.513 15.581 6.149 19.287 11.813 19.287C17.477 19.287 22.111 15.581 22.111 11.049C22.111 9.091 21.287 7.341 19.948 6.002L20.463 1.573C20.514 1.059 19.948 0.75 19.536 0.956L15.828 3.428C14.593 3.015 13.254 2.809 11.813 2.809C10.371 2.809 9.031 3.015 7.796 3.428L4.089 0.956ZM7.281 10.431C7.796 10.431 8.723 10.945 8.723 11.563C8.723 12.181 7.796 12.696 7.281 12.696C6.767 12.696 6.354 12.181 6.354 11.563C6.354 10.945 6.767 10.431 7.281 10.431ZM16.344 10.431C16.858 10.431 17.271 10.945 17.271 11.563C17.271 12.181 16.858 12.696 16.344 12.696C15.828 12.696 14.902 12.181 14.902 11.563C14.902 10.945 15.828 10.431 16.344 10.431ZM11.813 13.109C12.533 13.109 13.15 13.418 13.15 13.932C13.15 14.345 12.533 14.654 11.813 14.654C11.091 14.654 10.473 14.345 10.473 13.932C10.473 13.418 11.091 13.109 11.813 13.109ZM16.79 33.877C22.453 34.219 25.887 30.444 26.745 25.294C27.259 22.205 26.745 18.773 25.2 16.026C25.029 15.683 24.6 15.683 24.428 16.026C23.14 18.429 23.742 21.862 23.313 24.78C22.626 29.072 19.88 31.302 16.619 31.646ZM17.648 35.079C23.313 35.25 28.804 33.361 31.895 29.072C33.439 26.669 34.297 23.922 34.468 21.346C34.486 20.918 33.954 20.661 33.696 21.038C32.838 23.578 31.895 26.152 29.92 28.384C27.259 31.388 23.14 32.847 17.905 32.589Z"
                          Width="36" Height="36" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                <TextBlock x:Uid="GamepadMappingTitle" services:Localized.Uid="GamepadMappingTitle" FontSize="36" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock x:Uid="GamepadMappingDescription" services:Localized.Uid="GamepadMappingDescription" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"/>
        </StackPanel>

        <!-- Row 1：工具列（搜尋方塊 + 排序下拉選單，釘住不捲） -->
            <Border x:Name="ToolbarCard"
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16"
                    MinWidth="700"
                    MaxWidth="700"
                    Visibility="Collapsed">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox" Grid.Column="0"
                             x:Uid="GamepadMappingSearchBox" services:Localized.Uid="GamepadMappingSearchBox"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown"/>

                    <!-- 項目由 code-behind 動態填入（Content 走 .Loc 已在地化）。ComboBox i18n 慣例，見 code-behind。 -->
                    <ComboBox x:Name="SortCombo" Grid.Column="1"
                              MinWidth="200"
                              SelectionChanged="SortCombo_SelectionChanged"/>
                </Grid>
            </Border>

            <!-- Row 2：清單卡片，撐滿剩餘高度（VerticalAlignment=Stretch + Row 高度=*）。
                 ListView 因此有受限視窗高度 → 開啟虛擬化、自己出捲軸。 -->
            <Border x:Name="ListCard"
                    Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    MinWidth="700"
                    MaxWidth="700">
                <Grid>
                    <ListView x:Name="ProfileList"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              IsTabStop="False"
                              ItemClick="ProfileList_ItemClick"
                              Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:GamepadProfileRow">
                                <Grid Padding="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind SubText}" FontSize="12" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Click="DeleteItemButton_Click"
                                            Tag="{x:Bind AppId}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <!-- 顯式 ItemsPanel + Loaded 快取：WinAppSDK 2.x 的 ItemsPanelRoot 不可靠讀回 null，
                             改在 panel 自身 Loaded 取 sender 快取，供 PageBy 算每頁可見項數。 -->
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel Loaded="ItemsPanel_Loaded"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>

                    <!-- 搜尋無結果提示，疊在 ListView 上方同一個 Grid cell -->
                    <TextBlock x:Name="NoSearchResultHint"
                               x:Uid="GamepadMappingNoSearchResultHint" services:Localized.Uid="GamepadMappingNoSearchResultHint"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,32"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 空清單狀態：撐滿清單區（Row 2）整格作為量測基準，內容用內層 StackPanel 置中。
                 EmptyState 本身 Stretch 才能拿到 Row 2 的真實可用高度供 ResizeMascot 計算，
                 否則高度被立繪內容反向撐出 → 循環依賴 → 立繪縮成一丁點。 -->
            <Grid x:Name="EmptyState"
                  Grid.Row="2"
                  Visibility="Collapsed"
                  SizeChanged="EmptyState_SizeChanged">
                <StackPanel Spacing="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border x:Name="MascotBorder"
                            CornerRadius="24"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                        <Image x:Name="MascotImage"
                               Stretch="Fill"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"/>
                    </Border>
                    <TextBlock x:Name="EmptyHint"
                               x:Uid="GamepadMappingEmptyHint" services:Localized.Uid="GamepadMappingEmptyHint"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
    </Grid>
</Page>
