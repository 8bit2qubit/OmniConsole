<Page
    x:Class="OmniConsole.Pages.Settings.GamepadMapping.GamepadProfileEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:OmniConsole.Services">

    <Page.Resources>
        <ResourceDictionary>
            <!-- 跨頁共用：CardBackgroundFillColorDefaultBrush（#25282C） + 可聚焦資訊卡片 InfoCardStyle。 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../PhantomViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 工具列按鈕內容樣板：字串過長（如西語）以 WrapWholeWords 換行顯示。
                 換行後，完整文字都看得到，按鈕自動長高、不需 ToolTip。 -->
            <DataTemplate x:Key="WrapButtonContent" x:DataType="x:String">
                <TextBlock Text="{x:Bind}" TextWrapping="WrapWholeWords" TextAlignment="Center"/>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer" Padding="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="700" Margin="0,24,0,24">

            <!-- 頁首卡片：App 名稱 + appId 副文字 + 繫結路徑（僅 process 類顯示），可被手把焦點落。
                 XYFocusDown 由 code-behind 設定：阻擋雙重輸入開關停用時避開它。 -->
            <ContentControl x:Name="HeaderCard" Style="{StaticResource InfoCardStyle}" HorizontalAlignment="Stretch" MinWidth="700">
                <StackPanel Padding="16" Spacing="4">
                    <TextBlock x:Name="AppNameText" FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AppIdText"   FontSize="12" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="PathDisplayPanel" Orientation="Vertical" Spacing="2" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock x:Uid="GamepadProfile_PathBoundLabel" services:Localized.Uid="GamepadProfile_PathBoundLabel"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PathHintText"
                                   FontSize="11"
                                   FontFamily="Consolas"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <!-- 工具列 + BlockNativeGamepadInput 合併群組 -->
            <TextBlock x:Uid="GamepadMappingToolsSection" services:Localized.Uid="GamepadMappingToolsSection" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel>
                    <!-- BlockNativeGamepadInput 開關 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE785;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="GamepadProfile_BlockNativeGamepadInput_Title" services:Localized.Uid="GamepadProfile_BlockNativeGamepadInput_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="GamepadProfile_BlockNativeGamepadInput_Description" services:Localized.Uid="GamepadProfile_BlockNativeGamepadInput_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="GamepadProfile_BlockNativeGamepadInput_Note" services:Localized.Uid="GamepadProfile_BlockNativeGamepadInput_Note" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="BlockNativeGamepadInputSwitch"
                                      Toggled="BlockNativeGamepadInputSwitch_Toggled"
                                      FlowDirection="RightToLeft"
                                      Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0"/>
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- 行程優先權下拉 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xEC4A;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Uid="GamepadProfile_MappingServicePriority_Title" services:Localized.Uid="GamepadProfile_MappingServicePriority_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                            <TextBlock x:Uid="GamepadProfile_MappingServicePriority_Description" services:Localized.Uid="GamepadProfile_MappingServicePriority_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox x:Name="ProcessPriorityCombo" Grid.Column="2" VerticalAlignment="Center" MinWidth="160"
                                  SelectionChanged="ProcessPriorityCombo_SelectionChanged"/>
                    </Grid>

                    <!-- 分隔線 -->
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                    <!-- 工具列：4 顆按鈕「平分」可用寬度（4 等寬 * 欄），加總恆等於容器寬→永不溢出；
                         過長字串（西語）由 WrapButtonContent 在格子內換行顯示（見上方樣板註解），按鈕自動長高、完整可見。 -->
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE713;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CopyFromButton"     Grid.Column="0" Margin="0,0,4,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Uid="GamepadMappingCopyFromButton" services:Localized.Uid="GamepadMappingCopyFromButton"     FontSize="14" Padding="8" ContentTemplate="{StaticResource WrapButtonContent}"     Click="CopyFromButton_Click"     XYFocusUp="{x:Bind ProcessPriorityCombo}"/>
                            <Button x:Name="ClearAllButton"     Grid.Column="1" Margin="4,0"   VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Uid="GamepadMappingClearAllButton" services:Localized.Uid="GamepadMappingClearAllButton"     FontSize="14" Padding="8" ContentTemplate="{StaticResource WrapButtonContent}"     Click="ClearAllButton_Click"     XYFocusUp="{x:Bind ProcessPriorityCombo}"/>
                            <Button x:Name="ResetButton"        Grid.Column="2" Margin="4,0"   VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Uid="GamepadMappingResetButton" services:Localized.Uid="GamepadMappingResetButton"        FontSize="14" Padding="8" ContentTemplate="{StaticResource WrapButtonContent}"        Click="ResetButton_Click"        XYFocusUp="{x:Bind ProcessPriorityCombo}"/>
                            <Button x:Name="ResetClassicButton" Grid.Column="3" Margin="4,0,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Uid="GamepadMappingResetClassicButton" services:Localized.Uid="GamepadMappingResetClassicButton" FontSize="14" Padding="8" ContentTemplate="{StaticResource WrapButtonContent}" Click="ResetClassicButton_Click" XYFocusUp="{x:Bind ProcessPriorityCombo}"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 面鍵群組 -->
            <TextBlock x:Uid="GamepadGroup_FaceButtons" services:Localized.Uid="GamepadGroup_FaceButtons" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel Padding="16" Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF093;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_A" services:Localized.Uid="GamepadInput_A" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboA" Grid.Column="1" HorizontalAlignment="Stretch" Tag="A" SelectionChanged="ActionCombo_SelectionChanged" XYFocusUp="{x:Bind ClearAllButton}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button    x:Name="KeyBtnA" Tag="A" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                            <ToggleButton x:Name="RepeatBtnA" Tag="A" Click="RepeatToggle_Click" Margin="8,0,0,0" Visibility="Collapsed" x:Uid="GamepadRepeatToggle" services:Localized.Uid="GamepadRepeatToggle"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF094;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_B" services:Localized.Uid="GamepadInput_B" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboB" Grid.Column="1" HorizontalAlignment="Stretch" Tag="B" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button    x:Name="KeyBtnB" Tag="B" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                            <ToggleButton x:Name="RepeatBtnB" Tag="B" Click="RepeatToggle_Click" Margin="8,0,0,0" Visibility="Collapsed" x:Uid="GamepadRepeatToggle" services:Localized.Uid="GamepadRepeatToggle"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF096;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_X" services:Localized.Uid="GamepadInput_X" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboX" Grid.Column="1" HorizontalAlignment="Stretch" Tag="X" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button    x:Name="KeyBtnX" Tag="X" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                            <ToggleButton x:Name="RepeatBtnX" Tag="X" Click="RepeatToggle_Click" Margin="8,0,0,0" Visibility="Collapsed" x:Uid="GamepadRepeatToggle" services:Localized.Uid="GamepadRepeatToggle"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF095;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_Y" services:Localized.Uid="GamepadInput_Y" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboY" Grid.Column="1" HorizontalAlignment="Stretch" Tag="Y" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button    x:Name="KeyBtnY" Tag="Y" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                            <ToggleButton x:Name="RepeatBtnY" Tag="Y" Click="RepeatToggle_Click" Margin="8,0,0,0" Visibility="Collapsed" x:Uid="GamepadRepeatToggle" services:Localized.Uid="GamepadRepeatToggle"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 肩鍵 / 板機群組 -->
            <TextBlock x:Uid="GamepadGroup_Shoulders" services:Localized.Uid="GamepadGroup_Shoulders" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel Padding="16" Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF10C;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_LB" services:Localized.Uid="GamepadInput_LB" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboLB" Grid.Column="1" HorizontalAlignment="Stretch" Tag="LB" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button    x:Name="KeyBtnLB" Tag="LB" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                            <ToggleButton x:Name="RepeatBtnLB" Tag="LB" Click="RepeatToggle_Click" Margin="8,0,0,0" Visibility="Collapsed" x:Uid="GamepadRepeatToggle" services:Localized.Uid="GamepadRepeatToggle"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF10D;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_RB" services:Localized.Uid="GamepadInput_RB" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboRB" Grid.Column="1" HorizontalAlignment="Stretch" Tag="RB" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button    x:Name="KeyBtnRB" Tag="RB" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                            <ToggleButton x:Name="RepeatBtnRB" Tag="RB" Click="RepeatToggle_Click" Margin="8,0,0,0" Visibility="Collapsed" x:Uid="GamepadRepeatToggle" services:Localized.Uid="GamepadRepeatToggle"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF10A;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_LT" services:Localized.Uid="GamepadInput_LT" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboLT" Grid.Column="1" HorizontalAlignment="Stretch" Tag="LT" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button    x:Name="KeyBtnLT" Tag="LT" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                            <ToggleButton x:Name="RepeatBtnLT" Tag="LT" Click="RepeatToggle_Click" Margin="8,0,0,0" Visibility="Collapsed" x:Uid="GamepadRepeatToggle" services:Localized.Uid="GamepadRepeatToggle"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF10B;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_RT" services:Localized.Uid="GamepadInput_RT" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboRT" Grid.Column="1" HorizontalAlignment="Stretch" Tag="RT" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button    x:Name="KeyBtnRT" Tag="RT" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                            <ToggleButton x:Name="RepeatBtnRT" Tag="RT" Click="RepeatToggle_Click" Margin="8,0,0,0" Visibility="Collapsed" x:Uid="GamepadRepeatToggle" services:Localized.Uid="GamepadRepeatToggle"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 搖桿按下群組 -->
            <TextBlock x:Uid="GamepadGroup_ThumbButtons" services:Localized.Uid="GamepadGroup_ThumbButtons" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel Padding="16" Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF108;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_LS" services:Localized.Uid="GamepadInput_LS" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboLS" Grid.Column="1" HorizontalAlignment="Stretch" Tag="LS" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button    x:Name="KeyBtnLS" Tag="LS" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                            <ToggleButton x:Name="RepeatBtnLS" Tag="LS" Click="RepeatToggle_Click" Margin="8,0,0,0" Visibility="Collapsed" x:Uid="GamepadRepeatToggle" services:Localized.Uid="GamepadRepeatToggle"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF109;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_RS" services:Localized.Uid="GamepadInput_RS" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboRS" Grid.Column="1" HorizontalAlignment="Stretch" Tag="RS" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button    x:Name="KeyBtnRS" Tag="RS" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                            <ToggleButton x:Name="RepeatBtnRS" Tag="RS" Click="RepeatToggle_Click" Margin="8,0,0,0" Visibility="Collapsed" x:Uid="GamepadRepeatToggle" services:Localized.Uid="GamepadRepeatToggle"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 搖桿 / 十字鍵群組 -->
            <TextBlock x:Uid="GamepadGroup_Sticks" services:Localized.Uid="GamepadGroup_Sticks" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <StackPanel Padding="16" Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF108;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_LStick" services:Localized.Uid="GamepadInput_LStick" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboLStick" Grid.Column="1" HorizontalAlignment="Stretch" Tag="LStick" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <ToggleButton x:Name="RepeatBtnLStick" Grid.Column="2" Tag="LStick" Click="RepeatToggle_Click" Margin="8,0,0,0" Visibility="Collapsed" x:Uid="GamepadRepeatToggle" services:Localized.Uid="GamepadRepeatToggle"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF109;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_RStick" services:Localized.Uid="GamepadInput_RStick" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboRStick" Grid.Column="1" HorizontalAlignment="Stretch" Tag="RStick" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <ToggleButton x:Name="RepeatBtnRStick" Grid.Column="2" Tag="RStick" Click="RepeatToggle_Click" Margin="8,0,0,0" Visibility="Collapsed" x:Uid="GamepadRepeatToggle" services:Localized.Uid="GamepadRepeatToggle"/>
                    </Grid>
                    <!-- DPad 主行：選 Arrows / WASD / Numpad / Custom / None -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xF10E;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="22"/>
                            <TextBlock x:Uid="GamepadInput_DPad" services:Localized.Uid="GamepadInput_DPad" VerticalAlignment="Center" FontSize="15"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboDPad" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ComboDPad_SelectionChanged"/>
                        <ToggleButton x:Name="RepeatBtnDPad" Grid.Column="2" Tag="DPadUp" Click="RepeatToggle_Click" Margin="8,0,0,0" Visibility="Collapsed" x:Uid="GamepadRepeatToggle" services:Localized.Uid="GamepadRepeatToggle"/>
                    </Grid>

                    <!-- DPad 自訂模式 4 子列（Visibility 由 code-behind 控制） -->
                    <Grid x:Name="DPadCustomRowUp" Visibility="Collapsed" Margin="24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE0E4;" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="18"/>
                            <TextBlock x:Uid="GamepadInput_DPadUp" services:Localized.Uid="GamepadInput_DPadUp" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                        <ComboBox  x:Name="ComboDPadUp" Grid.Column="1" HorizontalAlignment="Stretch" Tag="DPadUp" SelectionChanged="ActionCombo_SelectionChanged"/>
                        <Button    x:Name="KeyBtnDPadUp" Grid.Column="2" Tag="DPadUp" Click="ChangeKey_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <Grid x:Name="DPadCustomRowDown" Visibility="Collapsed" Margin="24,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="136"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
