<Page
    x:Class="OmniConsole.Pages.Settings.General.GeneralHostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:OmniConsole.Services"
    xmlns:local="using:OmniConsole.Pages.Settings.General">

    <Grid x:Name="GeneralHostRoot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,16">
            <!-- 含品牌名：改由 code-behind 設值（注入品牌）；保留 Localized.Uid 讓社群語言外掛切換仍能套用。 -->
            <TextBlock x:Name="SettingsTitleText" services:Localized.Uid="SettingsTitle" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"/>
            <TextBlock x:Name="SettingsDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"/>
        </StackPanel>

        <!-- 分類索引標籤（System/User）：Content 為內層 Frame，切標籤即導覽對應子頁（整頁橫滑、卡片不個別動）。 -->
        <NavigationView x:Name="PlatformCategoryNav"
                        Grid.Row="1"
                        PaneDisplayMode="Top"
                        Background="Transparent"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="PlatformCategoryNav_SelectionChanged"
                        XYFocusKeyboardNavigation="Enabled">

            <!-- Phantom 配色：Top 索引標籤橫條融入主背景 -->
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                <!-- 移除 Top 模式 ContentGrid 與 pane 之間的 1px 分隔線 -->
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_SystemPlatforms" services:Localized.Uid="Nav_SystemPlatforms" Tag="System" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_UserPlatforms" services:Localized.Uid="Nav_UserPlatforms" Tag="User">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 社群平台鈕與匯入按鈕位置在 tabs 橫列（屬宿主 NavigationView），但邏輯轉發給目前 User 子頁；
                 顯隱由宿主依目前 tab 與 consent 一併控（兩按鈕同條件）。 -->
            <NavigationView.PaneFooter>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="CommunityPlatformsButton"
                            x:Uid="CommunityPlatformsButton" services:Localized.Uid="CommunityPlatformsButton"
                            Visibility="Collapsed"
                            Click="CommunityPlatformsButton_Click"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                    <Button x:Name="ImportPlatformButton"
                            x:Uid="ImportPlatformButton" services:Localized.Uid="ImportPlatformButton"
                            Visibility="Collapsed"
                            Click="ImportPlatformButton_Click"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <!-- 內層 Frame：System/User 子頁切換目標 -->
            <Frame x:Name="InnerFrame"/>
        </NavigationView>
    </Grid>
</Page>
