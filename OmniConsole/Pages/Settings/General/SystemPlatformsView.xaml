<local:PlatformsViewBase
    x:Class="OmniConsole.Pages.Settings.General.SystemPlatformsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OmniConsole.Models"
    xmlns:services="using:OmniConsole.Services"
    xmlns:local="using:OmniConsole.Pages.Settings.General">

    <local:PlatformsViewBase.Resources>
        <ResourceDictionary Source="PlatformGridStyles.xaml"/>
    </local:PlatformsViewBase.Resources>

    <Grid x:Name="SystemRoot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- 系統內建平台卡片網格（依可用寬度自動決定欄數，垂直捲動）。
             不設 ItemContainerTransitions：系統平台清單固定不增刪、切標籤靠宿主 Frame 整頁橫滑、卡片不個別動。 -->
        <GridView x:Name="PlatformGridView"
                  SelectionMode="Single"
                  SingleSelectionFollowsFocus="False"
                  HorizontalAlignment="Stretch"
                  IsTabStop="False"
                  SizeChanged="PlatformGridView_SizeChanged"
                  SelectionChanged="PlatformGridView_SelectionChanged">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid x:Name="PlatformWrapGrid" Orientation="Horizontal" Loaded="PlatformWrapGrid_Loaded"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.ItemContainerStyle>
                <StaticResource ResourceKey="PlatformGridViewItemStyle"/>
            </GridView.ItemContainerStyle>

            <GridView.ItemTemplate>
                <DataTemplate x:DataType="models:PlatformCardItem">
                    <!-- Opacity 由 CardOpacity 決定：1.0 = 已安裝，0.2 = 未安裝 -->
                    <!-- OneWay：PlatformCardItem 實作 INPC，可用性變化原地更新、不換實例不重建容器 -->
                    <Border CornerRadius="16" Margin="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Opacity="{x:Bind CardOpacity, Mode=OneWay}">
                        <Grid>
                            <!-- 平台圖片作為全滿卡片背景 -->
                            <Image Source="{x:Bind IconSource, Mode=OneWay}" Stretch="UniformToFill"/>
                            <!-- 底部文字區域，半透明暗底確保文字可讀性 -->
                            <Border VerticalAlignment="Bottom"
                                    CornerRadius="0,0,12,12"
                                    Background="#BB000000">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="8,5,8,5"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</local:PlatformsViewBase>
