<Page
    x:Class="OmniConsole.Pages.Settings.TroubleshootView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:OmniConsole.Services"
    xmlns:local="using:OmniConsole.Pages.Settings">

    <Page.Resources>
        <!-- 跨頁共用：CardBackgroundFillColorDefaultBrush（#25282C）。 -->
        <ResourceDictionary Source="PhantomViewStyles.xaml"/>
    </Page.Resources>

    <!-- 捲動內收：頁面內建 ScrollViewer，內容超出可視範圍時可捲動。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- 標題/副標滿版置中，不受卡片 700 寬度限制；左右 Margin 24 避開右側捲軸（撐滿時不壓到 ScrollBar）。 -->
            <TextBlock x:Uid="TroubleshootTitle" services:Localized.Uid="TroubleshootTitle" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"/>
            <TextBlock x:Uid="TroubleshootDescription" services:Localized.Uid="TroubleshootDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"/>
            <!-- 卡片內容群組：維持 700 窄欄 -->
            <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="700" Margin="0,8,0,0">

            <!-- FSE 分類標題 -->
            <TextBlock x:Uid="TroubleshootSection_Fse" services:Localized.Uid="TroubleshootSection_Fse" FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,0,0,0"/>

            <!-- FSE 群組卡片 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    MinWidth="700">
                <Grid Padding="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE72C;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Uid="ResetGameBarSetting_Title" services:Localized.Uid="ResetGameBarSetting_Title" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                        <TextBlock x:Uid="ResetGameBarSetting_Description" services:Localized.Uid="ResetGameBarSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                        <!-- <TextBlock x:Uid="ResetGameBarSetting_Note" services:Localized.Uid="ResetGameBarSetting_Note" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/> -->
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ResetGameBarButton" x:Uid="ResetGameBarButton" services:Localized.Uid="ResetGameBarButton"
                                Click="ResetGameBarButton_Click"
                                FontSize="14" Padding="24,8"/>
                        <ProgressRing x:Name="ResetGameBarProgressRing"
                                      IsActive="False" Visibility="Collapsed"
                                      Width="20" Height="20"/>
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
