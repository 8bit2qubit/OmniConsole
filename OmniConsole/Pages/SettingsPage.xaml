<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OmniConsole.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OmniConsole.Models"
    xmlns:services="using:OmniConsole.Services"
    xmlns:controls="using:OmniConsole.Controls">

    <UserControl.Resources>
        <!-- Phantom 配色：設定卡片背景 #25282C -->
        <!-- 預設 #0DFFFFFF（半透白）疊在 #1A1B1E 上會合成 #262729，需直接以實色覆寫 -->
        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#25282C"/>

        <!-- 關於頁卡片群組可聚焦容器：D-pad 焦點可落在資訊區塊上，
             ScrollViewer 收到焦點變更時呼叫 BringIntoView 將其捲入可視範圍。
             焦點視覺由 system focus visual（白色 3px 外框）提供。 -->
        <Style x:Key="AboutCardFocusStyle" TargetType="ContentControl">
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="White"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="3"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="Transparent"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="0"/>
            <Setter Property="FocusVisualMargin" Value="-3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <!-- 群組 1：設定導覽頁面切換（General / Advanced / Troubleshoot / About / GamepadMapping 五選一） -->
            <VisualStateGroup x:Name="SettingsNavPage">
                <!-- General：預設狀態，GeneralPage 預設 Visible，其餘預設 Collapsed -->
                <VisualState x:Name="General"/>
                <VisualState x:Name="Advanced">
                    <VisualState.Setters>
                        <Setter Target="GeneralPage.Visibility" Value="Collapsed"/>
                        <Setter Target="AdvancedPage.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Troubleshoot">
                    <VisualState.Setters>
                        <Setter Target="GeneralPage.Visibility" Value="Collapsed"/>
                        <Setter Target="TroubleshootPage.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="About">
                    <VisualState.Setters>
                        <Setter Target="GeneralPage.Visibility" Value="Collapsed"/>
                        <Setter Target="AboutPage.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="GamepadMapping">
                    <VisualState.Setters>
                        <Setter Target="GeneralPage.Visibility" Value="Collapsed"/>
                        <Setter Target="GamepadMappingPage.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- 群組 2：手把映射分頁內容（清單 vs 編輯器，二選一） -->
            <VisualStateGroup x:Name="GamepadMappingContent">
                <VisualState x:Name="GamepadMappingListVisible"/>
                <VisualState x:Name="GamepadMappingEditorVisible">
                    <VisualState.Setters>
                        <Setter Target="GamepadProfileList.Visibility" Value="Collapsed"/>
                        <Setter Target="GamepadProfileEditor.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- 群組 3：General 頁內容（系統平台卡片 vs 自訂平台卡片+免責聲明，二選一） -->
            <VisualStateGroup x:Name="GeneralContent">
                <!-- GridViewVisible：預設狀態，PlatformGridView 預設 Visible，CustomConsentPanel 預設 Collapsed -->
                <VisualState x:Name="GridViewVisible"/>
                <VisualState x:Name="ConsentVisible">
                    <VisualState.Setters>
                        <Setter Target="PlatformGridView.Visibility" Value="Collapsed"/>
                        <Setter Target="CustomConsentPanel.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- 群組 4：關於頁雙欄/單欄版型切換（由 AboutPage_SizeChanged 依實際可用寬切換） -->
            <VisualStateGroup x:Name="AboutLayoutStates">
                <!-- 寬螢幕（預設）：兩欄並排；標題與動作跨兩欄 -->
                <VisualState x:Name="WideAboutState"/>
                <!-- 窄螢幕：單欄垂直；動作群組置頂以利手把焦點 -->
                <VisualState x:Name="NarrowAboutState">
                    <VisualState.Setters>
                        <Setter Target="AboutTitleGroup.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="AboutActionsGroup.(Grid.Row)" Value="1"/>
                        <Setter Target="AboutActionsGroup.(Grid.Column)" Value="0"/>
                        <Setter Target="AboutActionsGroup.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="AboutSuiteGroup.(Grid.Row)" Value="2"/>
                        <Setter Target="AboutSuiteGroup.(Grid.Column)" Value="0"/>
                        <Setter Target="AboutPhantomKeyGroup.(Grid.Row)" Value="3"/>
                        <Setter Target="AboutPhantomKeyGroup.(Grid.Column)" Value="0"/>
                        <Setter Target="AboutXfsetGroup.(Grid.Row)" Value="4"/>
                        <Setter Target="AboutXfsetGroup.(Grid.Column)" Value="0"/>
                        <Setter Target="AboutHardwareGroup.(Grid.Row)" Value="5"/>
                        <Setter Target="AboutHardwareGroup.(Grid.Column)" Value="0"/>
                        <Setter Target="AboutSystemGroup.(Grid.Row)" Value="6"/>
                        <Setter Target="AboutSystemGroup.(Grid.Column)" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!-- 群組 5：底部手把提示列的按鍵圖示（依頁面與索引標籤狀態組合） -->
            <VisualStateGroup x:Name="GamepadHints">
                <!-- NonGeneralPage：預設狀態，LBRB/Y/X 提示預設均 Collapsed -->
                <VisualState x:Name="NonGeneralPage"/>
                <!-- SystemTab：General 頁 + 系統索引標籤，顯示 LB/RB 切換提示 -->
                <!-- GamepadHintMenu 由 code-behind 根據 FseService.IsActive() 動態控制，不在此設定 -->
                <VisualState x:Name="SystemTab">
                    <VisualState.Setters>
                        <Setter Target="GamepadHintLBRB.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- UserTabNoConsent：General 頁 + 使用者索引標籤 + 未接受免責聲明，顯示 LB/RB 但無 Y/X/Menu -->
                <VisualState x:Name="UserTabNoConsent">
                    <VisualState.Setters>
                        <Setter Target="GamepadHintLBRB.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- UserTabWithConsent：General 頁 + 使用者索引標籤 + 已接受，顯示 LB/RB + Y（新增）+ X（編輯）-->
                <!-- GamepadHintMenu 由 code-behind 根據 FseService.IsActive() 動態控制，不在此設定 -->
                <VisualState x:Name="UserTabWithConsent">
                    <VisualState.Setters>
                        <Setter Target="GamepadHintLBRB.Visibility" Value="Visible"/>
                        <Setter Target="GamepadHintY.Visibility" Value="Visible"/>
                        <Setter Target="GamepadHintX.Visibility" Value="Visible"/>
                        <Setter Target="ImportPlatformButton.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- GamepadMappingListTab：清單頁的提示列狀態（X 刪除由 code-behind 依 HasItems 控制） -->
                <VisualState x:Name="GamepadMappingListTab"/>
                <!-- GamepadMappingEditorTab：編輯器頁，B 改為「儲存並返回」，隱藏一般退出提示 -->
                <VisualState x:Name="GamepadMappingEditorTab">
                    <VisualState.Setters>
                        <Setter Target="GamepadHintExit.Visibility" Value="Collapsed"/>
                        <Setter Target="GamepadHintBSaveReturn.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- 設定模式：多頁面導覽介面 -->
        <!-- 掌機最佳化：預設隱藏導覽選單，僅顯示漢堡按鈕以最大化內容空間 -->
        <NavigationView x:Name="SettingsNav"
                        PaneDisplayMode="LeftMinimal"
                        IsPaneOpen="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="SettingsNav_SelectionChanged"
                        XYFocusKeyboardNavigation="Enabled">

            <!-- 掌機最佳化：覆寫漢堡選單按鈕樣式以符合 64px 導覽列寬度 -->
            <NavigationView.PaneToggleButtonStyle>
                <Style TargetType="Button"
                       BasedOn="{StaticResource PaneToggleButtonStyle}">
                    <!-- 增大按鈕點選區域並移除內距，確保在 64x64 空間中完全填滿 -->
                    <Setter Property="MinWidth" Value="64"/>
                    <Setter Property="MinHeight" Value="64"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <!-- 自訂範本以確保圖示在較大按鈕中精確置中，並適配 WinUI 3 的視覺狀態 -->
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="RootGrid"
                                      Background="{TemplateBinding Background}"
                                      CornerRadius="{TemplateBinding CornerRadius}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="RootGrid.Background" Value="{ThemeResource NavigationViewButtonBackgroundPointerOver}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="RootGrid.Background" Value="{ThemeResource NavigationViewButtonBackgroundPressed}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="RootGrid.Background" Value="{ThemeResource NavigationViewButtonBackgroundDisabled}"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <!-- 手動定義漢堡選單圖示 (Glyph E700)，確保其在自訂範本中精確置中 -->
                                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              Glyph="&#xE700;"
                                              FontSize="24"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </NavigationView.PaneToggleButtonStyle>

            <!-- 佔位空間：解決漢堡按鈕與下方導覽項目重疊的問題 (維持 64px 高度一致性) -->
            <NavigationView.PaneHeader>
                <Grid Height="64"/>
            </NavigationView.PaneHeader>

            <NavigationView.Resources>
                <!-- 掌機最佳化：加大導覽列寬度與項目高度 -->
                <x:Double x:Key="NavigationViewCompactPaneLength">64</x:Double>
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">64</x:Double>

                <!-- 選取指示器寬度與高度 -->
                <x:Double x:Key="NavigationViewSelectionIndicatorWidth">6</x:Double>
                <x:Double x:Key="NavigationViewSelectionIndicatorHeight">24</x:Double>

                <!-- Phantom 配色：覆寫 LeftMinimal overlay pane 為純色 #25282C -->
                <!-- 預設指向 AcrylicInAppFillColorDefaultBrush 造成磨砂半透視，需直接以 SolidColorBrush 覆寫 -->
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#25282C"/>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
            </NavigationView.Resources>

            <!-- 主要導覽項目 -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_General" Tag="General" IsSelected="True" FontSize="24">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF0E2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Advanced" Tag="Advanced" FontSize="24">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_GamepadMapping" Tag="GamepadMapping" FontSize="24">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF191;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_Troubleshoot" Tag="Troubleshoot" FontSize="24">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <Grid Margin="64,24,64,80">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 更新通知 InfoBar（佔版面固定區塊） -->
                    <InfoBar x:Name="SettingsUpdateInfoBar"
                             Grid.Row="0"
                             IsOpen="False" IsClosable="False"
                             Severity="Informational"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,16"/>

                    <!-- 一般設定頁面 -->
                    <Grid x:Name="GeneralPage" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,16">
                            <TextBlock x:Uid="SettingsTitle" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="SettingsDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="18" TextAlignment="Center"/>
                        </StackPanel>

                        <!-- 分類索引標籤 + 平台卡片 -->
                        <NavigationView x:Name="PlatformCategoryNav"
                                        Grid.Row="1"
                                        PaneDisplayMode="Top"
                                        Background="Transparent"
                                        IsBackButtonVisible="Collapsed"
                                        IsSettingsVisible="False"
                                        SelectionChanged="PlatformCategoryNav_SelectionChanged"
                                        XYFocusKeyboardNavigation="Enabled">

                            <!-- Phantom 配色：Top 索引標籤橫條融入主背景 -->
                            <NavigationView.Resources>
                                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Transparent"/>
                                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                                <!-- 移除 Top 模式 ContentGrid 與 pane 之間的 1px 分隔線 -->
                                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                            </NavigationView.Resources>

                            <NavigationView.MenuItems>
                                <NavigationViewItem x:Uid="Nav_SystemPlatforms" Tag="System" IsSelected="True">
                                    <NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE7FC;" />
                                    </NavigationViewItem.Icon>
                                </NavigationViewItem>
                                <NavigationViewItem x:Uid="Nav_UserPlatforms" Tag="User">
                                    <NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE77B;" />
                                    </NavigationViewItem.Icon>
                                </NavigationViewItem>
                            </NavigationView.MenuItems>

                            <NavigationView.PaneFooter>
                                <Button x:Name="ImportPlatformButton"
                                        x:Uid="ImportPlatformButton"
                                        Visibility="Collapsed"
                                        Click="ImportPlatformButton_Click"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                            </NavigationView.PaneFooter>

                            <Grid>
                            <!-- 平台選擇卡片網格（依可用寬度自動決定欄數，垂直捲動） -->
                            <GridView x:Name="PlatformGridView"
                                      SelectionMode="Single"
                                      SingleSelectionFollowsFocus="False"
                                      HorizontalAlignment="Stretch"
                                      IsTabStop="False"
                                      SizeChanged="PlatformGridView_SizeChanged"
                                      SelectionChanged="PlatformGridView_SelectionChanged">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid x:Name="PlatformWrapGrid" Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>

                                <GridView.Resources>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="{ThemeResource SystemAccentColorDark2}"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemAccentColorDark1}"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemAccentColorDark3}"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="{ThemeResource SystemAccentColorDark3}"/>
                                    <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="{ThemeResource SystemAccentColorDark2}"/>
                                </GridView.Resources>

                                <!-- 自訂 GridViewItem 模板：實現圓角選取/焦點效果 -->
                                <!-- 預設 ListViewItemPresenter 的 CornerRadius 屬性對焦點框和選取邊框無效，
                                     必須完整覆寫模板，用明確的 Border + CornerRadius 取代 -->
                                <GridView.ItemContainerStyle>
                                    <Style TargetType="GridViewItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="IsTabStop" Value="True"/>
                                        <Setter Property="MinWidth" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                        <!-- 停用系統預設直角焦點框，改由模板內的 FocusBorder 處理 -->
                                        <Setter Property="UseSystemFocusVisuals" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GridViewItem">
                                                    <Grid x:Name="RootGrid">
                                                        <!-- 選取/懸停背景（圓角） -->
                                                        <Border x:Name="BackgroundBorder" CornerRadius="14" Background="Transparent"/>
                                                        <!-- 手把/鍵盤焦點白框（圓角） -->
                                                        <Border x:Name="FocusBorder" CornerRadius="14" BorderThickness="3" BorderBrush="Transparent"/>
                                                        <ContentPresenter x:Name="ContentPresenter"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                          Margin="{TemplateBinding Padding}"/>
                                                        <VisualStateManager.VisualStateGroups>
                                                            <VisualStateGroup x:Name="CommonStates">
                                                                <VisualState x:Name="Normal"/>
                                                                <VisualState x:Name="PointerOver">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource GridViewItemBackgroundPointerOver}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Pressed">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource GridViewItemBackgroundPressed}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Selected">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource GridViewItemBackgroundSelected}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="PointerOverSelected">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource GridViewItemBackgroundSelectedPointerOver}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="PressedSelected">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="BackgroundBorder.Background" Value="{ThemeResource GridViewItemBackgroundSelectedPressed}"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                            </VisualStateGroup>
                                                            <VisualStateGroup x:Name="FocusStates">
                                                                <VisualState x:Name="Focused">
                                                                    <VisualState.Setters>
                                                                        <Setter Target="FocusBorder.BorderBrush" Value="White"/>
                                                                    </VisualState.Setters>
                                                                </VisualState>
                                                                <VisualState x:Name="Unfocused"/>
                                                                <VisualState x:Name="PointerFocused"/>
                                                            </VisualStateGroup>
                                                        </VisualStateManager.VisualStateGroups>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GridView.ItemContainerStyle>

                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PlatformCardItem">
                                        <!-- Opacity 由 CardOpacity 決定：1.0 = 已安裝，0.2 = 未安裝 -->
                                        <!-- 可用性更新後由程式碼重新指定 ItemsSource 觸發重新整理 -->
                                        <Border CornerRadius="16" Margin="8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                Opacity="{x:Bind CardOpacity}">
                                            <Border.ContextFlyout>
                                                <MenuFlyout Opening="CardContextMenu_Opening">
                                                    <MenuFlyoutItem x:Uid="CardMenu_Export" Click="CardExport_Click"/>
                                                </MenuFlyout>
                                            </Border.ContextFlyout>
                                            <Grid>
                                                <!-- 平台圖片作為全滿卡片背景 -->
                                                <Image Source="{x:Bind IconAsset}" Stretch="UniformToFill"/>
                                                <!-- 底部文字區域，半透明暗底確保文字可讀性 -->
                                                <Border VerticalAlignment="Bottom"
                                                        CornerRadius="0,0,12,12"
                                                        Background="#BB000000">
                                                    <TextBlock Text="{x:Bind DisplayName}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               Margin="8,5,8,5"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <!-- 自訂平台免責聲明（首次進入自訂索引標籤時顯示，接受後隱藏） -->
                            <ScrollViewer x:Name="CustomConsentPanel" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MaxWidth="600" Spacing="16" Padding="0,32">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="48"
                                              HorizontalAlignment="Center"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                    <TextBlock x:Uid="CustomPlatform_ConsentTitle"
                                               FontSize="24" FontWeight="Bold"
                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock x:Uid="CustomPlatform_ConsentBody"
                                               FontSize="14" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Button x:Name="CustomConsentAcceptButton"
                                            x:Uid="CustomPlatform_ConsentAccept"
                                            Click="CustomConsentAcceptButton_Click"
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource AccentButtonStyle}"
                                            FontSize="16" Padding="32,12" Margin="0,8,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                            </Grid>
                        </NavigationView>
                    </Grid>

                    <!-- 進階設定頁面 -->
                    <ScrollViewer x:Name="AdvancedPage" Grid.Row="1" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Padding="0">
                    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700">
                        <TextBlock x:Uid="AdvancedTitle" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Uid="AdvancedDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <!-- 更新分類標題 -->
                        <TextBlock x:Uid="AdvancedSection_Updates" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="2,0,0,0"/>

                        <!-- 更新群組卡片 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                MinWidth="700">
                            <StackPanel>
                                <!-- 版本號與檢查更新 -->
                                <Grid Padding="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE946;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Uid="VersionInfo_Title" FontWeight="SemiBold" FontSize="16" />
                                            <TextBlock x:Name="AdvancedVersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="16" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="UpdateCheckStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" Visibility="Collapsed"/>
                                        <StackPanel x:Name="DeveloperModeWarningPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                            <TextBlock x:Name="DeveloperModeWarningText" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" VerticalAlignment="Center"/>
                                            <HyperlinkButton x:Name="DeveloperModeOpenSettingsButton" x:Uid="DeveloperMode_OpenSettings" Click="DeveloperModeOpenSettings_Click" FontSize="12" Padding="4,2"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Name="DownloadInstallButton" x:Uid="DownloadInstallButton"
                                                Click="DownloadInstallButton_Click"
                                                Visibility="Collapsed"
                                                FontSize="14" Padding="24,8"/>
                                        <Button x:Name="CheckForUpdatesButton" x:Uid="CheckForUpdatesButton"
                                                Click="CheckForUpdatesButton_Click"
                                                FontSize="14" Padding="24,8"/>
                                        <ProgressRing x:Name="CheckUpdateProgressRing"
                                                      IsActive="False" Visibility="Collapsed"
                                                      Width="20" Height="20"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 下載進度 -->
                                <Grid x:Name="DownloadProgressPanel" Visibility="Collapsed" Padding="16,0,16,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0"
                                                 VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DownloadProgressText" Grid.Column="1"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>

                                <!-- 分隔線 -->
                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                                <!-- 自動檢查更新 -->
                                <Grid Padding="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE895;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Uid="AutoUpdateCheck_Title" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock x:Uid="AutoUpdateCheck_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <ToggleSwitch x:Name="AutoUpdateCheckSwitch"
                                                  Toggled="AutoUpdateCheckSwitch_Toggled"
                                                  FlowDirection="RightToLeft"
                                                  Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 手把輸入分類標題 -->
                        <TextBlock x:Uid="AdvancedSection_GamepadInput" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="2,0,0,0"/>

                        <!-- 手把輸入群組卡片 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                MinWidth="700">
                            <StackPanel>
                                <!-- PhantomKey 手把輸入 — 已改為 FSE 常駐，保留標題/描述作為以下設定的區段說明，僅註解開關 -->
                                <Grid Padding="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE961;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Uid="PhantomKeySetting_Title" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock x:Uid="PhantomKeySetting_Description" services:FluentIconTextHelper.AutoFormat="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock x:Uid="PhantomKeySetting_Note" services:FluentIconTextHelper.AutoFormat="True" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!--
                                    <ToggleSwitch x:Name="UsePhantomKeySwitch"
                                                  Toggled="UsePhantomKeySwitch_Toggled"
                                                  FlowDirection="RightToLeft"
                                                  Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                                    -->
                                </Grid>

                                <!-- 分隔線 -->
                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                                <!-- Steam In-Game Overlay -->
                                <Grid Padding="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xEA5B;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Uid="SteamInGameOverlaySetting_Title" services:FluentIconTextHelper.AutoFormat="True" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock x:Uid="SteamInGameOverlaySetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock x:Uid="SteamInGameOverlaySetting_Note" services:FluentIconTextHelper.AutoFormat="True" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <ToggleSwitch x:Name="UsePhantomKeySteamInGameOverlaySwitch"
                                                  Toggled="UsePhantomKeySteamInGameOverlaySwitch_Toggled"
                                                  FlowDirection="RightToLeft"
                                                  Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                                </Grid>

                                <!-- 分隔線 -->
                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                                <!-- Gamepad Mouse Mode 主開關 -->
                                <Grid Padding="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE962;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Uid="MouseModeSetting_Title" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock x:Uid="MouseModeSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock x:Uid="MouseModeSetting_Note" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="MouseModeBuiltInMappingNoteText" x:Uid="MouseModeSetting_BuiltInMappingNote" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                                    </StackPanel>

                                    <ComboBox x:Name="MouseModeCombo" Grid.Column="2"
                                              SelectionChanged="MouseModeCombo_SelectionChanged"
                                              MinWidth="120" VerticalAlignment="Center">
                                        <ComboBoxItem x:Uid="MouseModeItem_Off"     Tag="Off"/>
                                        <ComboBoxItem x:Uid="MouseModeItem_Auto"    Tag="Auto"/>
                                        <ComboBoxItem x:Uid="MouseModeItem_ForceOn" Tag="ForceOn"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Mouse Mode 版面配置切換 (OmniNav / Classic) -->
                                <Grid Padding="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE8AB;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Uid="MouseModeLayoutSetting_Title" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock x:Uid="MouseModeLayoutSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <ToggleSwitch x:Name="MouseModeLayoutSwitch"
                                                  x:Uid="MouseModeLayoutSwitch"
                                                  Toggled="MouseModeLayoutSwitch_Toggled"
                                                  FlowDirection="RightToLeft"
                                                  Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                                </Grid>

                                <!-- Cursor Speed 下拉選單 -->
                                <Grid Padding="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE7C9;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Uid="CursorSpeedSetting_Title" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock x:Uid="CursorSpeedSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <ComboBox x:Name="CursorSpeedCombo" Grid.Column="2"
                                              SelectionChanged="CursorSpeedCombo_SelectionChanged"
                                              MinWidth="120" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 介面音效分類標題 -->
                        <TextBlock x:Uid="AdvancedSection_Sound" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="2,0,0,0"/>

                        <!-- 介面音效群組卡片 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                MinWidth="700">
                            <StackPanel>
                                <!-- 導覽音效 -->
                                <Grid Padding="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE995;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Uid="NavigationSoundsSetting_Title" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock x:Uid="NavigationSoundsSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <ToggleSwitch x:Name="NavigationSoundsSwitch"
                                                  Toggled="NavigationSoundsSwitch_Toggled"
                                                  FlowDirection="RightToLeft"
                                                  Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--
                            Game Bar 進階設定（媒體櫃按鈕開啟設定 / Passthrough）暫時隱藏：
                            自 v1.9.0.0 起，OmniCharm 小工具按鈕已可直接進入 Xbox 媒體櫃；
                            而 Passthrough 目前僅 Xbox 平台有對應 URI，其它平台尚未發現可用入口，
                            開放給使用者調整反而容易踩雷（誤設後會無法從 Game Bar 媒體櫃進入 OmniConsole 設定介面）。
                            因此 UI 暫時隱藏，強制走 SettingsService 的預設值；待開發人員模式頁完工後再搬移過去。
                            （XAML 不支援巢狀註解，原本各小節的 <!~~ Game Bar 分類標題 ~~> /
                              <!~~ Game Bar 群組卡片 ~~> / <!~~ 媒體櫃按鈕開啟設定 ~~> /
                              <!~~ 分隔線 ~~> / <!~~ 直接導向平台 ~~> 子註解，於還原時依下列順序補回原位。）

                        <TextBlock x:Uid="AdvancedSection_GameBar" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="2,0,0,0"/>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                MinWidth="700">
                            <StackPanel>
                                <Grid Padding="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE8F1;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Uid="GameBarLibrarySetting_Title" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock x:Uid="GameBarLibrarySetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <ToggleSwitch x:Name="UseGameBarLibrarySwitch" x:Uid="UseGameBarLibrarySwitch"
                                                  Toggled="UseGameBarLibrarySwitch_Toggled"
                                                  FlowDirection="RightToLeft"
                                                  Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                                </Grid>

                                <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="16,0"/>

                                <Grid Padding="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE71B;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Uid="PassthroughSetting_Title" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock x:Uid="PassthroughSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock x:Uid="PassthroughSetting_Note" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <ToggleSwitch x:Name="EnablePassthroughSwitch" x:Uid="EnablePassthroughSwitch"
                                                  Toggled="EnablePassthroughSwitch_Toggled"
                                                  FlowDirection="RightToLeft"
                                                  Grid.Column="2" VerticalAlignment="Center" Margin="0" MinWidth="0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        -->

                    </StackPanel>
                    </ScrollViewer>

                    <!-- 疑難排解頁面 -->
                    <ScrollViewer x:Name="TroubleshootPage" Grid.Row="1" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Padding="0">
                    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700">
                        <TextBlock x:Uid="TroubleshootTitle" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Uid="TroubleshootDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <!-- FSE 分類標題 -->
                        <TextBlock x:Uid="TroubleshootSection_Fse" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="2,0,0,0"/>

                        <!-- FSE 群組卡片 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Stretch"
                                MinWidth="700">
                            <Grid Padding="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE72C;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Uid="ResetGameBarSetting_Title" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock x:Uid="ResetGameBarSetting_Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                    <!-- <TextBlock x:Uid="ResetGameBarSetting_Note" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/> -->
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="ResetGameBarButton" x:Uid="ResetGameBarButton"
                                            Click="ResetGameBarButton_Click"
                                            FontSize="14" Padding="24,8"/>
                                    <ProgressRing x:Name="ResetGameBarProgressRing"
                                                  IsActive="False" Visibility="Collapsed"
                                                  Width="20" Height="20"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- 關於頁面：顯示 OmniConsole Suite 版本、PhantomKey 健康狀況、XFSET 工具鏈狀態、環境快照，並提供複製到剪貼簿。
                         SizeChanged 由程式碼監聽，根據實際內容寬切換 Wide/Narrow VisualState。 -->
                    <ScrollViewer x:Name="AboutPage" Grid.Row="1" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Padding="0"
                                  SizeChanged="AboutPage_SizeChanged">
                    <!-- 雙欄版面：左欄為 OmniConsole 自家相關（Suite / PhantomKey Health / XFSET），右欄為環境（硬體 / 系統）。
                         標題與按鈕跨兩欄置中。1080p 大螢幕能直接顯示完所有區塊不需捲動。 -->
                    <!-- 自適應排版：每個卡片群組固定寬 700（與進階頁單欄一致）。
                         - 寬螢幕（≥1416）：兩欄 × 多列；標題與動作群組跨兩欄置頂
                         - 窄螢幕（<1416）：摺疊為單欄，依「動作 → Suite → PhantomKey → XFSET → Hardware → System」順序垂直排列
                         由 AboutPage_SizeChanged 呼叫 VisualStateManager.GoToState 切換，每個群組透過 Grid.Row / Grid.Column 重新定位 -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <!-- WideState 用 Row0/1（標題+動作跨兩欄）+ Row2/3/4（左欄三群組與右欄兩群組對齊）；
                                 NarrowState 額外使用 Row5/6 -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 標題（跨兩欄，置中） -->
                        <StackPanel x:Name="AboutTitleGroup" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                    Spacing="8" HorizontalAlignment="Center" Width="700" Margin="0,0,0,0">
                            <TextBlock x:Uid="AboutTitle" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Uid="AboutDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="18" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 動作群組（WideState：跨兩欄；NarrowState：單欄） -->
                        <StackPanel x:Name="AboutActionsGroup" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                    Spacing="8" HorizontalAlignment="Center" Width="700">
                            <TextBlock x:Uid="AboutSection_Actions" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="2,0,0,0"/>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    HorizontalAlignment="Stretch">
                                <Grid Padding="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8C8;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Uid="AboutActions_Title" FontWeight="SemiBold" FontSize="16"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock x:Uid="Label_CapturedAt" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock x:Name="AboutCapturedAtText" FontSize="14" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Name="CopyAboutButton" x:Uid="CopyAboutButton"
                                                Click="CopyAboutButton_Click"
                                                FontSize="14" Padding="24,8"/>
                                        <Button x:Name="RefreshAboutButton" x:Uid="RefreshAboutButton"
                                                Click="RefreshAboutButton_Click"
                                                FontSize="14" Padding="24,8"/>
                                        <!-- 進度環用 Opacity 切顯隱（保持 20×20 佔位）避免按鈕 row 重排造成寬度抖動 -->
                                        <ProgressRing x:Name="RefreshAboutProgressRing"
                                                      IsActive="False" Opacity="0"
                                                      Width="20" Height="20"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- OmniConsole Suite 群組（WideState：Row 2 col 0；NarrowState：Row 2 col 0） -->
                        <StackPanel x:Name="AboutSuiteGroup" Grid.Row="2" Grid.Column="0" Spacing="8" Width="700">
                            <TextBlock x:Uid="AboutSection_Suite" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="2,0,0,0"/>
                            <ContentControl Style="{StaticResource AboutCardFocusStyle}" HorizontalAlignment="Stretch">
                                <StackPanel Padding="16" Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_OmniConsole" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutOmniConsoleVersion" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_PhantomBridge" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutPhantomBridgeVersion" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_PhantomKey" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutPhantomKeyVersion" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_PhantomLink" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutPhantomLinkVersion" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>

                        <!-- PhantomKey 健康狀況群組（WideState：Row 3 col 0） -->
                        <StackPanel x:Name="AboutPhantomKeyGroup" Grid.Row="3" Grid.Column="0" Spacing="8" Width="700">
                            <TextBlock x:Uid="AboutSection_PhantomKey" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="2,0,0,0"/>
                            <ContentControl Style="{StaticResource AboutCardFocusStyle}" HorizontalAlignment="Stretch">
                                <StackPanel Padding="16" Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_PhantomKeyProcess" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutPhantomKeyProcessText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_PhantomKeyUptime" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutPhantomKeyUptimeText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_PhantomKeyIntegrity" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutPhantomKeyIntegrityText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_PhantomKeyResponsiveness" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutPhantomKeyResponsivenessText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>

                        <!-- XFSET 群組（WideState：Row 4 col 0） -->
                        <StackPanel x:Name="AboutXfsetGroup" Grid.Row="4" Grid.Column="0" Spacing="8" Width="700">
                            <TextBlock x:Uid="AboutSection_Xfset" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="2,0,0,0"/>
                            <ContentControl Style="{StaticResource AboutCardFocusStyle}" HorizontalAlignment="Stretch">
                                <StackPanel Padding="16" Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="XboxFullScreenExperienceTool.exe" FontSize="14" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutXfsetToolStatus" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="PhysPanelCS.exe" FontSize="14" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutXfsetPhysPanelStatus" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>

                        <!-- 硬體群組（WideState：Row 2 col 1） -->
                        <StackPanel x:Name="AboutHardwareGroup" Grid.Row="2" Grid.Column="1" Spacing="8" Width="700">
                            <TextBlock x:Uid="AboutSection_Hardware" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="2,0,0,0"/>
                            <ContentControl Style="{StaticResource AboutCardFocusStyle}" HorizontalAlignment="Stretch">
                                <StackPanel Padding="16" Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_System" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutSystemText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_Baseboard" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutBaseboardText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_Cpu" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutCpuText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_Ram" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutRamText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_Gpu" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutGpuText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>

                        <!-- 系統群組（WideState：Row 3 col 1） -->
                        <StackPanel x:Name="AboutSystemGroup" Grid.Row="3" Grid.Column="1" Spacing="8" Width="700">
                            <TextBlock x:Uid="AboutSection_System" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="2,0,0,0"/>
                            <ContentControl Style="{StaticResource AboutCardFocusStyle}" HorizontalAlignment="Stretch">
                                <StackPanel Padding="16" Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_WindowsBuild" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutWindowsBuildText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_FseState" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutFseStateText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_MaxTouchPoints" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutMaxTouchPointsText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_Locale" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutLocaleText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_CountryRegion" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutCountryRegionText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="Label_DeviceRegion" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,16,0"/>
                                        <TextBlock x:Name="AboutDeviceRegionText" Grid.Column="1" FontSize="14" FontFamily="Consolas" TextAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </ContentControl>
                        </StackPanel>

                    </Grid>
                    </ScrollViewer>

                    <!-- 手把映射頁面：清單與編輯器二選一切換（由 GamepadMappingContent VSM 控制） -->
                    <Grid x:Name="GamepadMappingPage" Grid.Row="1" Visibility="Collapsed"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <controls:GamepadProfileListView x:Name="GamepadProfileList"/>
                        <controls:GamepadProfileEditor x:Name="GamepadProfileEditor" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </NavigationView.Content>

            <!-- 底部選單項目：版本號與作者顯示（不可選取）+ 關於頁入口（可選取） -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="VersionItem" IsEnabled="False" SelectsOnInvoked="False">
                    <NavigationViewItem.Content>
                        <StackPanel>
                            <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="20"/>
                            <TextBlock Text="8bit2qubit (野理)" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="16"/>
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_About" Tag="About" FontSize="24">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
        </NavigationView>

        <!-- 全域手把按鍵提示列：固定於底部，設定介面所有頁面共用 -->
        <StackPanel x:Name="GamepadHintBar"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24" Spacing="32"
                    IsHitTestVisible="True">
            <!-- LB/RB 索引標籤切換提示 -->
            <StackPanel x:Name="GamepadHintLBRB" Orientation="Horizontal" Spacing="4" Visibility="Collapsed">
                <FontIcon Glyph="&#xF10C;" FontSize="22"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"/>
                <FontIcon Glyph="&#xF10D;" FontSize="22"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock x:Uid="GamepadHint_SwitchTab" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xF093;" FontSize="22"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"/>
                <TextBlock x:Uid="GamepadHint_Select" FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <!-- Y 鍵新增提示（僅使用者索引標籤時顯示，滑鼠可點選） -->
            <Button x:Name="GamepadHintY" Visibility="Collapsed"
                    Click="AddPlatformHintButton_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0" MinWidth="0" MinHeight="0"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF095;" FontSize="22"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="GamepadHint_Add" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- X 鍵編輯提示（僅使用者索引標籤時顯示，滑鼠可點選） -->
            <Button x:Name="GamepadHintX" Visibility="Collapsed"
                    Click="EditPlatformHintButton_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0" MinWidth="0" MinHeight="0"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF096;" FontSize="22"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="GamepadHint_Edit" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- Menu 鍵直接啟動提示（FSE 模式中 + 系統索引標籤或已接受自訂平台同意才顯示，滑鼠可點選） -->
            <Button x:Name="GamepadHintMenu" Visibility="Collapsed"
                    Click="LaunchPlatformHintButton_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0" MinWidth="0" MinHeight="0"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEDE3;" FontSize="22"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="GamepadHint_Launch" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- X 鍵：刪除（清單頁=刪選中項；編輯器頁=刪目前 profile）。Visibility 由 code-behind 控制 -->
            <Button x:Name="GamepadHintXDelete" Visibility="Collapsed"
                    Click="DeleteProfileHintButton_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0" MinWidth="0" MinHeight="0"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF096;" FontSize="22"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="GamepadHint_DeleteProfile" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- B 鍵：編輯器頁的「儲存並返回」（取代一般退出提示） -->
            <Button x:Name="GamepadHintBSaveReturn" Visibility="Collapsed"
                    Click="SaveProfileHintButton_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0" MinWidth="0" MinHeight="0"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF094;" FontSize="22"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="GamepadHint_SaveReturn" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- 滑鼠可點選退出，手把 B 鍵也觸發同一動作 -->
            <Button x:Name="GamepadHintExit" Click="ExitHintButton_Click"
                    Background="Transparent" BorderBrush="Transparent"
                    Padding="0" MinWidth="0" MinHeight="0"
                    IsTabStop="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF094;" FontSize="22"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Uid="GamepadHint_Exit" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <!-- 匯出成功提示（IsLightDismissEnabled：點選任意處關閉） -->
        <TeachingTip x:Name="ExportSuccessTeachingTip"
                     x:Uid="ExportSuccessTeachingTip"
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="False"/>

        <!-- 關於頁複製成功提示：樣式與 ExportSuccessTeachingTip 一致 -->
        <TeachingTip x:Name="AboutCopyConfirmTeachingTip"
                     x:Uid="AboutCopyConfirmTeachingTip"
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="False"/>
    </Grid>
</UserControl>
