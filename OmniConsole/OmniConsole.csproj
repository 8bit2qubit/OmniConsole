<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
		<RootNamespace>OmniConsole</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
		<UseWinUI>true</UseWinUI>
		<!-- 預設語言（在地化回退語言） -->
		<DefaultLanguage>en-US</DefaultLanguage>
		<EnableMsixTooling>true</EnableMsixTooling>
		<!-- 防止 MSIX Bundle 將語言資源拆分為獨立 Resource Package -->
		<AppxBundleAutoResourcePackageQualifiers>Scale;DXFeatureLevel</AppxBundleAutoResourcePackageQualifiers>
		<!-- 繫結 SCCD 檔案 -->
		<AppxCustomCapabilityCcd>CustomCapability.SCCD</AppxCustomCapabilityCcd>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- 自訂 Program.cs 進入點，用於實現單一實例 -->
		<DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>

		<!-- 版本資訊固定欄位；版號由下方 SyncVersionFromMainManifest target 從主 manifest 覆寫。 -->
		<Company>8bit2qubit</Company>
		<Product>OmniConsole</Product>
		<Authors>8bit2qubit</Authors>
		<Copyright>Copyright (C) 2026 8bit2qubit</Copyright>
		<AssemblyTitle>OmniConsole</AssemblyTitle>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<!-- 版本資訊跟隨主程式 Package.appxmanifest 的 Identity.Version。 -->
	<Target Name="SyncVersionFromMainManifest" BeforeTargets="GetAssemblyVersion;CoreCompile" Condition="Exists('$(ProjectDir)Package.appxmanifest')">
		<XmlPeek XmlInputPath="$(ProjectDir)Package.appxmanifest" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version">
			<Output TaskParameter="Result" PropertyName="_OmniVersion" />
		</XmlPeek>
		<PropertyGroup Condition="'$(_OmniVersion)' != ''">
			<Version>$(_OmniVersion)</Version>
			<FileVersion>$(_OmniVersion)</FileVersion>
			<AssemblyVersion>$(_OmniVersion)</AssemblyVersion>
		</PropertyGroup>
	</Target>

	<!-- 確保 SCCD 檔案被包含在專案中 -->
	<ItemGroup>
		<None Update="CustomCapability.SCCD">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\Platforms\*.png" />
	</ItemGroup>

	<!-- Mascot 立繪 -->
	<ItemGroup>
		<Content Remove="Assets\Mascots\**" />
		<PRIResource Remove="Assets\Mascots\**" />
		<None Remove="Assets\Mascots\**" />
		<EmbeddedResource Include="Assets\Mascots\Nekomata.jpg" Condition="Exists('$(MSBuildProjectDirectory)\Assets\Mascots\Nekomata.jpg')">
			<LogicalName>OmniConsole.Embedded.Nekomata.jpg</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!-- 內建回退桌布：玻璃材質讀不到系統桌布時使用。 -->
	<ItemGroup>
		<Content Remove="Assets\Backdrops\**" />
		<PRIResource Remove="Assets\Backdrops\**" />
		<None Remove="Assets\Backdrops\**" />
		<EmbeddedResource Include="Assets\Backdrops\Backdrop.jpg" Condition="Exists('$(MSBuildProjectDirectory)\Assets\Backdrops\Backdrop.jpg')">
			<LogicalName>OmniConsole.Embedded.Backdrop.jpg</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!-- PhantomKey：建置 C++ 專案並封裝進 MSIX -->
	<!-- OmniConsole 建置時自動觸發 PhantomKey 建置，跟隨 OmniConsole 的 Configuration -->
	<!-- Debug 版會輸出 PhantomKeyTrace.log，Release 版日誌完全移除 -->
	<Target Name="BuildPhantomKey" BeforeTargets="BeforeBuild">
		<MSBuild Projects="..\OmniConsole.PhantomKey\OmniConsole.PhantomKey.vcxproj" Targets="Build" Properties="Configuration=$(Configuration);Platform=x64" />
	</Target>
	<ItemGroup>
		<Content Include="..\OmniConsole.PhantomKey\x64\$(Configuration)\OmniConsole.PhantomKey.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>OmniConsole.PhantomKey.exe</Link>
		</Content>
		<Content Include="Phantom\OmniConsole.PhantomKey.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>OmniConsole.PhantomKey.dll</Link>
		</Content>
	</ItemGroup>

	<!-- 注入建置環境資訊到 AssemblyMetadata，供關於頁附帶診斷資訊使用 -->
	<Target Name="InjectBuildIdentity" BeforeTargets="GetAssemblyAttributes">
		<Exec Command="git rev-parse HEAD" ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="BuildCommitHashRaw" />
		</Exec>
		<Exec Command="git config --get remote.origin.url" ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="BuildRepoUrlRaw" />
		</Exec>
		<Exec Command="powershell -NoProfile -Command &quot;[TimeZoneInfo]::Local.Id&quot;" ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="BuildTimeZoneRaw" />
		</Exec>
		<Exec Command="powershell -NoProfile -Command &quot;[System.Globalization.CultureInfo]::CurrentCulture.Name&quot;" ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="BuildMachineCultureRaw" />
		</Exec>
		<Exec Command="powershell -NoProfile -Command &quot;$r = Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion'; $major = if ([int]$r.CurrentBuild -ge 22000) { 'Windows 11' } else { 'Windows 10' }; $edition = switch ($r.EditionID) { 'Professional' { 'Pro' } 'ProfessionalWorkstation' { 'Pro for Workstations' } 'ProfessionalN' { 'Pro N' } 'Enterprise' { 'Enterprise' } 'EnterpriseN' { 'Enterprise N' } 'Education' { 'Education' } 'EducationN' { 'Education N' } 'Home' { 'Home' } 'HomeN' { 'Home N' } 'Core' { 'Home' } 'CoreN' { 'Home N' } 'CoreSingleLanguage' { 'Home Single Language' } 'IoTEnterprise' { 'IoT Enterprise' } default { $r.EditionID } }; '{0} {1} {2} (Build {3}.{4})' -f $major, $edition, $r.DisplayVersion, $r.CurrentBuild, $r.UBR&quot;" ConsoleToMSBuild="true" ContinueOnError="true" IgnoreExitCode="true" StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="BuildMachineOSVersionRaw" />
		</Exec>
		<PropertyGroup>
			<BuildCommitHash>$(BuildCommitHashRaw.Trim())</BuildCommitHash>
			<BuildTimestamp>$([System.DateTimeOffset]::Now.ToString('yyyy-MM-dd HH:mm zzz'))</BuildTimestamp>
			<BuildRepoUrl>$(BuildRepoUrlRaw.Trim())</BuildRepoUrl>
			<BuildUserSignature>$(USERNAME)@$(COMPUTERNAME)</BuildUserSignature>
			<BuildTimeZone>$(BuildTimeZoneRaw.Trim())</BuildTimeZone>
			<BuildMachineCulture>$(BuildMachineCultureRaw.Trim())</BuildMachineCulture>
			<BuildMachineOSVersion>$(BuildMachineOSVersionRaw.Trim())</BuildMachineOSVersion>
			<BuildHostName>$(COMPUTERNAME)</BuildHostName>
		</PropertyGroup>
		<ItemGroup>
			<AssemblyMetadata Include="BuildCommitHash" Value="$(BuildCommitHash)" />
			<AssemblyMetadata Include="BuildTimestamp" Value="$(BuildTimestamp)" />
			<AssemblyMetadata Include="BuildRepoUrl" Value="$(BuildRepoUrl)" />
			<AssemblyMetadata Include="BuildUserSignature" Value="$(BuildUserSignature)" />
			<AssemblyMetadata Include="BuildTimeZone" Value="$(BuildTimeZone)" />
			<AssemblyMetadata Include="BuildMachineCulture" Value="$(BuildMachineCulture)" />
			<AssemblyMetadata Include="BuildMachineOSVersion" Value="$(BuildMachineOSVersion)" />
			<AssemblyMetadata Include="BuildHostName" Value="$(BuildHostName)" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<Content Include="Phantom\OmniConsole.PhantomPaw.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>OmniConsole.PhantomPaw.dll</Link>
		</Content>
		<Content Include="Phantom\OmniConsole.PhantomPaw32.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>OmniConsole.PhantomPaw32.dll</Link>
		</Content>
		<Content Include="Phantom\OmniConsole.PhantomSigil.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>OmniConsole.PhantomSigil.exe</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\SplashScreen.scale-200.png" />
		<Content Include="Assets\AppIcon.ico" />
		<Content Include="Assets\LockScreenLogo.scale-200.png" />
		<Content Include="Assets\Square150x150Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.scale-200.png" />
		<Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
		<Content Include="Assets\StoreLogo.png" />
		<Content Include="Assets\Wide310x150Logo.scale-200.png" />
	</ItemGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
	<ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<ProjectCapability Include="Msix" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260610101">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
		<PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="OmniConsole.Phantom">
			<HintPath>Phantom\OmniConsole.Phantom.dll</HintPath>
			<Private>true</Private>
		</Reference>
	</ItemGroup>

	<!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
	<PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
		<HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
	</PropertyGroup>

	<!-- Publish Properties -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<PublishReadyToRun>False</PublishReadyToRun>
		<PublishTrimmed>False</PublishTrimmed>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' != 'Debug'">
		<PublishAot>true</PublishAot>
	</PropertyGroup>
</Project>