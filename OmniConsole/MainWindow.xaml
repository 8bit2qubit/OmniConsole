<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OmniConsole.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OmniConsole">

    <Grid x:Name="RootGrid" Background="Transparent" RequestedTheme="Dark">
        <!-- 自繪桌布底圖：玻璃材質下顯示桌布、墊在 Frame 之下。 -->
        <Image x:Name="WallpaperBackdrop" Stretch="UniformToFill" Visibility="Collapsed"/>
        <!-- 桌布遮罩：疊在桌布上、Frame 之下，磨砂染色壓暗桌布讓上層 UI 可讀。 -->
        <Grid x:Name="WallpaperScrim" Visibility="Collapsed"/>
        <!-- 頂層單一 Frame：LaunchView 與 SettingsHostView 各為 Page、由 code-behind 導覽切換。 -->
        <Frame x:Name="RootContentFrame"/>
    </Grid>
</Window>
