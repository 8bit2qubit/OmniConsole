  <Target Name="GenerateVersionHeader" BeforeTargets="ResourceCompile;ClCompile">
    <Exec Command="powershell -NoProfile -Command &quot;[xml]$x = Get-Content '$(ProjectDir)..\OmniConsole\Package.appxmanifest'; $v = $x.Package.Identity.Version; $p = $v.Split('.'); $t = '// 自動產生，勿手動修改' + [char]10 + ('#define VERSION_MAJOR {0}' -f $p[0]) + [char]10 + ('#define VERSION_MINOR {0}' -f $p[1]) + [char]10 + ('#define VERSION_PATCH {0}' -f $p[2]) + [char]10 + ('#define VERSION_BUILD {0}' -f $p[3]) + [char]10 + ('#define VERSION_STR \&quot;{0}\&quot;' -f $v) + [char]10 + ('#define VERSION_CSV {0}' -f $v.Replace('.',',')) + [char]10; [IO.File]::WriteAllText('$(ProjectDir)version.h', $t)&quot;" />
  </Target>
  <Target Name="SignSteamExe" AfterTargets="Link"
          Condition="'$(OMNI_PFX_PATH)' != '' AND Exists('$(OMNI_PFX_PATH)')">
    <Exec Command="signtool sign /fd SHA256 /f &quot;$(OMNI_PFX_PATH)&quot; /p &quot;$(OMNI_PFX_PASSWORD)&quot; /t http://timestamp.digicert.com &quot;$(OutDir)Steam.exe&quot;" />
  </Target>
