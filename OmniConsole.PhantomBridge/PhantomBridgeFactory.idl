// Full Trust COM Server 對外介面。由 PhantomLink Widget（UWP AppContainer）
// 透過 CoCreateInstance(CLSCTX_LOCAL_SERVER) 取得，呼叫受 UWP 限制的桌面動作。
//
// 所有方法執行於獨立的 full trust 桌面行程（非 Widget/Game Bar），
// SendInput / ShellExecute 不受 AppContainer 封鎖、不受 Game Bar 輸入焦點捕獲干擾。

namespace PhantomBridge
{
    [default_interface]
    runtimeclass PhantomBridgeFactory
    {
        PhantomBridgeFactory();

        // 開啟 Windows 工作檢視
        void SendTaskView();

        // 開啟 OmniConsole 主程式設定頁（omniconsole://show-settings）
        // 註：目前 Widget UI 未提供入口（從 Game Bar Library 入口已能進入），保留供未來啟用
        void OpenSettings();

        // 送 Steam In-Game Overlay 快捷鍵；快捷鍵由呼叫端從 Shared.ini
        // [PhantomKey] SteamInGameOverlayShortcut 讀取後傳入（PhantomKey 寫入），
        // 預設 Shift+Tab，Steam 設定中可自訂；格式如 "Shift+Tab" / "Insert"。
        void TriggerSteamInGameOverlay(String shortcut);

        // 啟動 Xbox 媒體櫃（xbox://library URI）
        void OpenXboxLibrary();

        // 取前景視窗的 title / 行程名稱（不含 .exe）/ 完整路徑（含 .exe）/ AUMID / displayName / isElevated。
        // displayName 優先序：
        // (1) packaged → PackageManager manifest DisplayName；
        // (2) ApplicationFrameHost 宿主 → title；
        // (3) Win32 → exe 版本資源 FileDescription；
        // (4) 皆失敗 → title → process 名稱。
        // fullPath 由 QueryFullProcessImageNameW 取得；packaged 行程或取不到時回空字串。
        // 主程式建立 gamepad profile 時帶入 AppId.FullPath，用於撞名遊戲分流（如 Steam vs Epic 同名 exe）。
        // Widget 用於顯示「目前程式」並判定「自訂此 App 的手把映射」按鈕應否啟用；
        // profile 內部 key 仍用 processName（穩定）。非 packaged 行程 aumid 回空字串。
        // isElevated：前景行程是否以提升權限執行（admin token，High IL 以上）。PhantomKey 跑在 Medium IL，
        // UIPI 會靜默丟棄 SendInput 給高 IL 視窗（PhantomKey 按鍵送不到高 IL 視窗），故 Widget 收到 true 時要停用「自訂此 App」（自訂 profile 無效）。
        void GetForegroundAppInfo(out String title, out String processName, out String fullPath, out String aumid, out String displayName, out Boolean isElevated);

        // 喚起 OmniConsole 主程式編輯器（omniconsole://edit-gamepad-profile?appId=...&displayName=...&fullPath=...）
        // 流程：Win+G 收 Game Bar → ShellExecuteW（appId / displayName / fullPath 經 percent-encode）
        // fullPath 留空字串時 URI 不附該 query param，主程式建 profile 時 FullPath=null（name-only 通配）。
        void OpenProfileEditor(String appId, String name, String fullPath);
    }
}
