// Full Trust COM Server 對外介面。由 PhantomLink Widget（UWP AppContainer）
// 透過 CoCreateInstance(CLSCTX_LOCAL_SERVER) 取得，呼叫受 UWP 限制的桌面動作。
//
// 所有方法執行於獨立的 fulltrust 桌面行程（非 Widget/Game Bar），
// SendInput / ShellExecute 不受 AppContainer 封鎖、不受 Game Bar 輸入焦點捕獲干擾。

namespace PhantomBridge
{
    [default_interface]
    runtimeclass PhantomBridgeFactory
    {
        PhantomBridgeFactory();

        // 送 Win+Tab 開啟 Windows 工作檢視
        void SendTaskView();

        // 冷啟動 OmniConsole 主程式進入設定頁（omniconsole://show-settings）
        // 註：目前 Widget UI 未提供入口（從 Game Bar Library 入口已能進入），保留供未來啟用
        void OpenSettings();

        // 送 Steam In-Game Overlay 快捷鍵；快捷鍵由呼叫端從 Shared.ini
        // [PhantomKey] SteamInGameOverlayShortcut 讀取後傳入（PhantomKey 寫入），
        // 預設 Shift+Tab，Steam 設定中可自訂；格式如 "Shift+Tab" / "Insert"。
        void TriggerSteamInGameOverlay(String shortcut);

        // 啟動 Xbox 媒體櫃（xbox://library URI）
        void OpenXboxLibrary();
    }
}
